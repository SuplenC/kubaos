#!/usr/bin/env bash
# Done: ~/.ssh/authorized_keys, or authorized_keys2, which sshd also reads, lists a key, so someone
# can log in over SSH with passwords off.
set -euo pipefail
for f in "$HOME/.ssh/authorized_keys" "$HOME/.ssh/authorized_keys2"; do
  if [[ -r $f ]] && grep -qvE '^[[:space:]]*(#|$)' "$f"; then
    exit 0
  fi
done
exit 1
