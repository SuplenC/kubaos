#!/usr/bin/env bash
# Has a running sshd read its configuration again: ssh.service's reload checks it with sshd -t
# first, then sends sshd a HUP, and a configuration sshd -t refuses fails the reload, leaving the
# running sshd as it was. Once the reload went through, the mark is touched, so ./reloaded knows
# the running sshd read the drop-in (systemd's own record of a reload command's start is lost at
# every daemon-reload, and is kept for a reload that failed too). An sshd that isn't running
# reads it as it next starts.
# With --after-removal, as a removal runs it once the drop-in is gone, the mark goes, and a reload
# that fails (sshd -t refusing the user's own configuration, the package already gone) leaves
# sshd as it runs and fails nothing: that sshd still takes keys alone.
# Usage: ./reload-sshd <path of the mark> [--after-removal]
set -euo pipefail
mark=$1
if [[ ${2-} == --after-removal ]]; then
  rm -f "$mark"
  systemctl try-reload-or-restart ssh.service || true
  exit 0
fi
systemctl try-reload-or-restart ssh.service
mkdir -p "$(dirname "$mark")"
touch "$mark"
