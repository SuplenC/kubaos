[Desktop Entry]
Type=Application
Name=Zen Browser
GenericName=Web Browser
Comment=Browse the web, with the tabs in a sidebar
Exec="@HOME@/.local/opt/zen-browser/zen.AppImage" %u
Icon=zen-browser
Terminal=false
StartupNotify=true
StartupWMClass=zen
Categories=Network;WebBrowser;
Keywords=browser;web;internet;firefox;
MimeType=text/html;text/xml;application/xhtml+xml;application/xml;application/pdf;application/json;application/rss+xml;application/rdf+xml;application/x-xpinstall;image/avif;image/gif;image/jpeg;image/png;image/svg+xml;image/webp;audio/flac;audio/ogg;audio/webm;video/ogg;video/webm;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/mailto;x-scheme-handler/chrome;
Actions=new-window;private-window;profiles;

[Desktop Action new-window]
Name=New Window
Exec="@HOME@/.local/opt/zen-browser/zen.AppImage" --new-window %u

[Desktop Action private-window]
Name=New Private Window
Exec="@HOME@/.local/opt/zen-browser/zen.AppImage" --private-window %u

[Desktop Action profiles]
Name=Profiles
Exec="@HOME@/.local/opt/zen-browser/zen.AppImage" --ProfileManager
