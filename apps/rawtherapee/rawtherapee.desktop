[Desktop Entry]
Type=Application
Name=RawTherapee
GenericName=Raw Photo Editor
Comment=Develop raw photos
Exec="@HOME@/.local/opt/rawtherapee/RawTherapee.AppImage" %f
Icon=com.rawtherapee.RawTherapee
Terminal=false
StartupNotify=true
