#!/usr/bin/env bash
# Rebuilds the menu folder's `mimeinfo.cache` once Navicat's entries are gone. Navicat runs
# update-desktop-database there as it starts, so the cache would otherwise keep its `navicat*`
# link handlers, naming an entry that is no longer there.
set -euo pipefail
applications="$HOME/.local/share/applications"
if [[ -d "$applications" ]]; then
  update-desktop-database "$applications"
fi
