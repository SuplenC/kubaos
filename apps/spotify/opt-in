#!/usr/bin/env bash
# Removes spotify.list when it is the one ./opt-out wrote, word for word; any other is left.
# Usage: ./opt-in <path of spotify.list>
set -euo pipefail
ours='# KubaOS sets Spotify'"'"'s repository up in spotify.sources, with a key for it alone. This file
# being here keeps Spotify'"'"'s package from adding the repository a second time.'
if [[ -f "$1" && "$(<"$1")" == "$ours" ]]; then
  rm -f "$1"
fi
