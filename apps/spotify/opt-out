#!/usr/bin/env bash
# Writes the file whose being there keeps Spotify's package from adding its repository: its
# postinst adds it as spotify.list, with no key named, unless a .list file has it or spotify.list
# is there, and reads no .sources file, so KubaOS's spotify.sources alone would leave apt with the
# repository twice and two keys for it, which fails every apt run.
# Usage: ./opt-out <path of spotify.list>
set -euo pipefail
[[ -e "$1" ]] && exit 0
cat >"$1" <<'TEXT'
# KubaOS sets Spotify's repository up in spotify.sources, with a key for it alone. This file
# being here keeps Spotify's package from adding the repository a second time.
TEXT
chmod 644 "$1"
