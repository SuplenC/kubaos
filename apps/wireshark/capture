#!/usr/bin/env bash
# Answers wireshark-common's debconf question yes: dumpcap gets the capabilities capturing needs,
# not setuid root, and the wireshark group may run it. A wireshark-common already configured is
# configured again, so its answer reaches dumpcap.
# Usage: ./capture
set -euo pipefail
echo 'wireshark-common wireshark-common/install-setuid boolean true' | debconf-set-selections
if dpkg-query -W -f '${db:Status-Abbrev}' wireshark-common 2>/dev/null | grep -q '^ii'; then
  dpkg-reconfigure --frontend noninteractive wireshark-common
fi
