#!/usr/bin/env bash
# Takes away the entries JetBrains Toolbox made for itself, its menu entry and its start-at-login
# entry, once it has stopped, as it writes them back while it runs. The entries of its IDEs stay
# with the IDEs.
set -euo pipefail
pkill -u "$(id -u)" -x jetbrains-toolbox || true
tries=0
while pgrep -u "$(id -u)" -x jetbrains-toolbox >/dev/null; do
  if ((tries >= 20)); then
    echo "JetBrains Toolbox didn't quit: quit it from its tray icon, then try again" >&2
    exit 1
  fi
  tries=$((tries + 1))
  sleep 0.5
done
rm -f "$HOME/.local/share/applications/jetbrains-toolbox.desktop" \
  "$HOME/.config/autostart/jetbrains-toolbox.desktop"
