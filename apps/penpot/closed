#!/bin/sh
# Exits 0 while no window of the web app $1 is open, found by the browser folder it runs with: an
# install, a removal or a switch replaces or deletes its desktop entry and icon, and the stack it
# shows, under it.
# Usage: ./closed <web app id>
! pgrep -u "$(id -u)" -f -- "--user-data-dir=$HOME/.local/share/kubaos/web-apps/$1( |\$)" >/dev/null
