# Ollama's server, as KubaOS runs it: a user of its own made as it starts (DynamicUser), its
# models and keys in its state folder, /var/lib/ollama, and nothing else of the machine writable,
# the homes hidden. It answers on this machine alone. The render and video groups open the GPUs
# (/dev/dri, AMD's /dev/kfd); NVIDIA's devices are open to everyone. CUDA makes a missing
# /dev/nvidia-uvm through the setuid nvidia-modprobe, which the server's user can't gain, so it is
# made first, as root (`+`); without NVIDIA's driver it fails, and `-` lets the server start
# anyway. The program is the version's own folder's, so a release rewrites this file, which
# restarts the server on the new version.

[Unit]
Description=Ollama
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=-+/usr/bin/nvidia-modprobe -u -c=0
ExecStart=/opt/ollama/@VERSION@/bin/ollama serve
DynamicUser=yes
StateDirectory=ollama
SupplementaryGroups=render video
Environment=HOME=/var/lib/ollama
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/var/lib/ollama/models
ProtectHome=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
