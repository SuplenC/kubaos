#!/usr/bin/env bash
# dot-bw-setup: log in to Bitwarden once, then set up everything that comes
# from the vault. Safe to re-run; docs/SECRETS.md has the vault conventions.
#
#   dot-bw-setup                    first run: asks for the server once, logs
#                                   in, unlocks, configures everything
#   dot-bw-setup --refresh          after changing the vault: unlock and
#                                   reconfigure, no questions (fails if logged out)
#   dot-bw-setup --check            no bw at all: check the SSH agent and show
#                                   what's configured
#   --server URL|com|eu             Bitwarden server (stored; com = bitwarden.com,
#                                   eu = bitwarden.eu, or your self-hosted URL)
#   --login totp|apikey|sso         how to log in when logged out (default: ask).
#                                   totp: email, master password and the
#                                   authenticator-app code (bw can't do FIDO2
#                                   keys); apikey: the fallback, no two-step
#                                   code (password is an alias of totp)
#   --only ssh,git,gh,env           just these parts (default: all)
#
# What it configures, from the whole vault, whatever folder an item is in:
#   ssh   every SSH key item -> ~/.ssh/<name>.pub, and a Host block in
#         ~/.ssh/config.d/bitwarden for each one with a 'hosts' field
#   git   commit signing with the key marked signing=true,
#         ~/.config/git-bitwarden/{signing.gitconfig,allowed_signers}
#   gh    token from item "gh-token" -> gh's keyring entry
#   env   every project -> GNOME keyring (dot-bwenv), for `use bwenv` in .envrc
#   agent checks the Bitwarden desktop SSH agent answers
# folder=<name> in ~/.config/dot-bw/config narrows ssh and git to that folder.
#
# Private keys never leave the vault; nothing secret is written to disk or
# logged. BW_SESSION exists only in this process and the bw/dot-bwenv
# processes it starts. bw prompts for the master password and 2FA itself.
#
# (~ in messages is for display.)
# shellcheck disable=SC2088
set -euo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dot-bw"
CONF="$CONF_DIR/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dot-bw"
GIT_DIR_OUT="${XDG_CONFIG_HOME:-$HOME/.config}/git-bitwarden"
SSH_DIR="$HOME/.ssh"
AGENT_SOCK="${BITWARDEN_SSH_AUTH_SOCK:-$HOME/.bitwarden-ssh-agent.sock}"

if [[ -t 1 ]]; then
  C_STEP=$'\e[1;34m' C_OK=$'\e[32m' C_WARN=$'\e[1;33m' C_ERR=$'\e[1;31m' C_OFF=$'\e[0m'
else
  C_STEP='' C_OK='' C_WARN='' C_ERR='' C_OFF=''
fi
step() { printf '\n%s==> %s%s\n' "$C_STEP" "$*" "$C_OFF"; }
ok() { printf '%s  ok%s  %s\n' "$C_OK" "$C_OFF" "$*"; }
info() { printf '      %s\n' "$*"; }
warn() { printf '%s  !!  %s%s\n' "$C_WARN" "$*" "$C_OFF" >&2; WARNINGS+=("$*"); }
die() { printf '%s  xx  %s%s\n' "$C_ERR" "$*" "$C_OFF" >&2; exit 1; }
usage() { sed -n '2,/^# Private keys/{/^# Private keys/d; s/^# \{0,1\}//p}' "${BASH_SOURCE[0]}"; }

WARNINGS=() SUMMARY=()
REFRESH=0 CHECK=0 LOGIN="" SERVER_ARG="" ONLY="ssh,git,gh,env"
while (($#)); do
  case "$1" in
    --refresh) REFRESH=1 ;;
    --check) CHECK=1 ;;
    --server) SERVER_ARG="${2:?--server needs a URL}"; shift ;;
    --login) LOGIN="${2:?--login needs password, apikey or sso}"; shift ;;
    --only) ONLY="${2:?--only needs a list}"; shift ;;
    -h | --help) usage; exit 0 ;;
    *) die "unknown argument: $1 (see --help)" ;;
  esac
  shift
done
case "$LOGIN" in "" | totp | apikey | sso) ;; password) LOGIN=totp ;; *) die "--login: totp, apikey or sso" ;; esac
want() { [[ ",$ONLY," == *",$1,"* ]]; }

# --- config (non-secret: server URL, email, folder) -----------------------
conf_get() {
  [[ -r $CONF ]] || return 0
  awk -F= -v k="$1" '$1 == k { sub(/^[^=]*=/, ""); print; exit }' "$CONF"
}
conf_set() {
  local tmp
  mkdir -p "$CONF_DIR"
  tmp="$(mktemp "$CONF_DIR/.config.XXXXXX")"
  { [[ -r $CONF ]] && grep -v "^$1=" "$CONF" || true; printf '%s=%s\n' "$1" "$2"; } >"$tmp"
  mv "$tmp" "$CONF"
}
server_url() {
  case "$1" in
    com | bitwarden.com | https://bitwarden.com | https://vault.bitwarden.com) echo https://vault.bitwarden.com ;;
    eu | bitwarden.eu | https://bitwarden.eu | https://vault.bitwarden.eu) echo https://vault.bitwarden.eu ;;
    https://*) echo "${1%/}" ;;
    *) die "server must be com, eu or an https:// URL, not '$1'" ;;
  esac
}
ask() { # ask VAR PROMPT
  [[ -t 0 ]] || die "need an answer for '$2' but stdin isn't a terminal"
  local reply
  read -r -p "      $2 " reply
  printf -v "$1" '%s' "$reply"
}

# --- small helpers ------------------------------------------------------------
# slug NAME: a file name from an item name ("GitHub (work)" -> github-work).
slug() {
  local s
  s="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9._-]+/-/g; s/^[-.]+//; s/-+$//')"
  printf '%s' "${s:-key}"
}
# write_file DEST MODE: stdin to DEST atomically, only if the content changed.
# Prints "changed" or "same".
write_file() {
  local dest="$1" mode="$2" tmp
  mkdir -p "$(dirname "$dest")"
  tmp="$(mktemp "$(dirname "$dest")/.dot-bw.XXXXXX")"
  cat >"$tmp"
  chmod "$mode" "$tmp"
  if [[ -f $dest ]] && cmp -s "$tmp" "$dest"; then
    rm -f "$tmp"
    echo same
  else
    mv -f "$tmp" "$dest"
    echo changed
  fi
}
# gitcfg ARGS: git config as every repo sees it (system, ~/.config/git/config
# and ~/.gitconfig). Not --global: that reads only ~/.gitconfig once it exists.
gitcfg() { (cd / && GIT_DIR=/nonexistent git config "$@" 2>/dev/null); }
truthy() { [[ ${1,,} =~ ^(true|yes|1)$ ]]; }
# field ITEM_JSON NAME: a custom field's value ("" when missing).
field() { jq -r --arg n "$2" '[.fields[]? | select(.name == $n) | .value][0] // "" | tostring' <<<"$1"; }
# key_label ITEM_JSON: the item's name and folder, which tells apart two keys of the same name.
# It goes into a comment in ssh_config, so a control character (a newline would
# start a directive) becomes a space.
key_label() { jq -r '"\(.name) (\(.folder))" | gsub("[\u0000-\u001f\u007f]"; " ")' <<<"$1"; }
# list WORDS: the words joined with ", ".
list() {
  local out
  printf -v out '%s, ' "$@"
  printf '%s' "${out%, }"
}

# name_pub_files: give every item in $ssh_items a .file, the name of its .pub,
# each one different. Items come oldest first, so of two keys with the same name
# the older keeps the plain name and a new one never takes over a .pub in use.
name_pub_files() {
  local name want folder base file k
  local -a files=()
  local -A owner=()
  # One line per item, fields split by US (0x1f): a tab is IFS whitespace, and
  # read would merge the empty 'file' field into the next.
  while IFS=$'\x1f' read -r name want folder; do
    base="$(slug "${want:-$name}")"
    file="$base" k=2
    while [[ -n ${owner[$file]:-} ]]; do
      file="$base-$k"
      ((k++))
    done
    if [[ $file != "$base" ]]; then
      warn "~/.ssh/$base.pub is taken by ${owner[$base]}: \"$name\" ($folder) gets ~/.ssh/$file.pub (a 'file' field on it picks the name)"
    fi
    owner[$file]="\"$name\" ($folder)"
    files+=("$file")
  done < <(jq -r '.[] | [.name, ([.fields[] | select(.name == "file") | .value][0] // ""), .folder]
    | map(tostring | gsub("[\n\r\u001f]"; " ")) | join("\u001f")' <<<"$ssh_items")
  ssh_items="$(jq -c '[to_entries[] | .value + {file: $ARGS.positional[.key]}]' --args "${files[@]}" <<<"$ssh_items")"
}

# --- bw -----------------------------------------------------------------------
SESSION=""
# bwq ARGS: bw with the session, never prompting; stderr shown only on failure.
bwq() {
  local err rc=0 out
  err="$(mktemp)"
  out="$(BW_SESSION="$SESSION" BW_NOINTERACTION=true bw "$@" 2>"$err")" || rc=$?
  if ((rc)); then
    grep -v -i -E 'punycode|trace-deprecation' "$err" | sed 's/^/      bw: /' >&2 || true
    rm -f "$err"
    return "$rc"
  fi
  rm -f "$err"
  printf '%s' "$out"
}

bw_login_unlock() {
  local status_json status cur_server server email method
  step "Bitwarden login"
  SESSION="${BW_SESSION:-}"   # reuse a session you exported yourself
  status_json="$(bwq status)" || die "bw status failed"
  status="$(jq -r .status <<<"$status_json")"
  cur_server="$(jq -r '.serverUrl // "https://vault.bitwarden.com"' <<<"$status_json")"
  cur_server="$(server_url "$cur_server")"

  server="$(conf_get server)"
  [[ -n $SERVER_ARG ]] && server="$(server_url "$SERVER_ARG")"
  if [[ -z $server && $status != unauthenticated ]]; then
    server="$cur_server"   # logged in already: adopt bw's server
  fi
  if [[ -z $server ]]; then
    ((REFRESH)) && die "not set up yet: run dot-bw-setup without --refresh"
    info "Which Bitwarden server holds your vault?"
    info "  1) bitwarden.com (US cloud)   2) bitwarden.eu (EU cloud)   3) self-hosted"
    local choice url
    ask choice "Choice [1-3]:"
    case "$choice" in
      1) server=https://vault.bitwarden.com ;;
      2) server=https://vault.bitwarden.eu ;;
      3) ask url "Server URL (https://...):"; server="$(server_url "$url")" ;;
      *) die "pick 1, 2 or 3" ;;
    esac
  fi
  [[ "$(conf_get server)" == "$server" ]] || conf_set server "$server"

  if [[ $status != unauthenticated && $cur_server != "$server" ]]; then
    die "bw is logged in to $cur_server, not $server: run 'bw logout' first"
  fi

  case "$status" in
    unlocked)
      ok "unlocked ($(jq -r .userEmail <<<"$status_json"), session from BW_SESSION)"
      return
      ;;
    locked)
      ok "logged in as $(jq -r .userEmail <<<"$status_json") on $server"
      ;;
    unauthenticated)
      ((REFRESH)) && die "bw is logged out: run dot-bw-setup (without --refresh) to log in"
      [[ $cur_server == "$server" ]] || bwq config server "$server" >/dev/null
      method="$LOGIN"
      if [[ -z $method ]]; then
        info "How do you log in? bw can't use the YubiKey (FIDO2) for two-step login;"
        info "it does authenticator-app codes, email codes and YubiKey OTP."
        info "  1) email + master password + authenticator-app code (recommended, Enter)"
        info "  2) personal API key (web vault: Settings -> Security -> Keys -> View API key),"
        info "     if you have no authenticator app as two-step method; asked now, never stored"
        info "  3) SSO (your organization's identity provider, in the browser)"
        local choice
        ask choice "Choice [1-3]:"
        case "${choice:-1}" in 1) method=totp ;; 2) method=apikey ;; 3) method=sso ;; *) die "pick 1, 2 or 3" ;; esac
      fi
      if [[ $method == totp ]]; then
        email="$(conf_get email)"
        [[ -n $email ]] || { ask email "Email:"; conf_set email "$email"; }
        # --method 0: the authenticator app, even when the YubiKey is the
        # account's preferred method. bw prompts on stderr (master password,
        # then the 6-digit code) and prints only the session key on stdout.
        if ! SESSION="$(bw login "$email" --method 0 --raw)"; then
          SESSION=""
          warn "authenticator-app login failed (wrong code, or no authenticator app on the account?)"
          [[ -t 0 && -z $LOGIN ]] || die "try again, or: dot-bw-setup --login apikey"
          local again
          ask again "Log in with the personal API key instead? [y/N]"
          [[ ${again,,} == y* ]] || die "not logged in"
          WARNINGS=("${WARNINGS[@]:0:${#WARNINGS[@]}-1}")
          method=apikey
        fi
      fi
      case "$method" in
        totp) ;;
        apikey)
          # bw asks for client_id and client_secret itself; they go to bw only.
          bw login --apikey >/dev/null || die "API key login failed"
          ;;
        sso)
          bw login --sso >/dev/null || die "SSO login failed"
          ;;
      esac
      ok "logged in on $server"
      ;;
    *) die "unexpected bw status '$status'" ;;
  esac

  if [[ -z $SESSION ]]; then
    # Master password prompt (bw 2026.10 can also ask the desktop app to
    # unlock with system authentication, when the server enables it).
    SESSION="$(bw unlock --raw)" || die "unlock failed"
  fi
  [[ -n $SESSION ]] || die "bw returned no session"
  ok "vault unlocked for this run"
}

# --- ssh ------------------------------------------------------------------------
setup_ssh() {
  local items="$1" n i item name label file pub fp hosts host_name user port block conf="" managed_new="" old h
  local -a words with_block=() key_only=()
  local -A host_owner=()
  step "SSH: public keys and Host blocks"
  install -d -m 0700 "$SSH_DIR" "$SSH_DIR/config.d"
  install -d -m 0700 "$STATE_DIR"
  n="$(jq 'length' <<<"$items")"
  for ((i = 0; i < n; i++)); do
    item="$(jq -c ".[$i]" <<<"$items")"
    name="$(jq -r .name <<<"$item")"
    label="$(key_label "$item")"
    pub="$(jq -r '.publicKey // ""' <<<"$item")"
    fp="$(jq -r '.fingerprint // ""' <<<"$item")"
    if [[ ! $pub =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp[0-9]+)\ [A-Za-z0-9+/=]+$ ]]; then
      warn "$label: no usable public key in the item, skipped"
      continue
    fi
    file="$(jq -r .file <<<"$item")"
    # A private key of that name on disk means this name is taken by a real key.
    if [[ -e $SSH_DIR/$file && -f $SSH_DIR/$file.pub ]] && [[ "$(cut -d' ' -f1,2 "$SSH_DIR/$file.pub")" != "$pub" ]]; then
      warn "$label: ~/.ssh/$file is a different key on disk; set a 'file' field to pick another name"
      continue
    fi
    printf '%s %s\n' "$pub" "bitwarden:$name" | write_file "$SSH_DIR/$file.pub" 0644 >/dev/null
    managed_new+="$file.pub"$'\n'
    ok "~/.ssh/$file.pub  ($fp)"

    hosts="$(field "$item" hosts)"
    host_name="$(field "$item" hostname)"
    user="$(field "$item" user)"
    port="$(field "$item" port)"
    # Field values end up in ssh_config: refuse anything that could add a
    # directive (a newline plus ProxyCommand would run commands).
    if [[ "$hosts$host_name$user$port" == *[[:cntrl:]]* ]]; then
      warn "$label: a hosts/hostname/user/port field has a newline or control character; no Host block"
      continue
    fi
    read -r -a words <<<"${hosts//,/ }"
    hosts="${words[*]}"
    if [[ -z $hosts ]]; then
      info "no 'hosts' field: key only, no Host block"
      key_only+=("$label")
      continue
    fi
    if [[ ! $hosts =~ ^[][A-Za-z0-9.*?!_:%\ -]+$ || -n $host_name && ! $host_name =~ ^[A-Za-z0-9._:%-]+$ ||
      -n $user && ! $user =~ ^[A-Za-z0-9._@-]+$ || -n $port && ! $port =~ ^[0-9]{1,5}$ ]]; then
      warn "$label: hosts/hostname/user/port contain characters ssh_config can't take safely; no Host block"
      continue
    fi
    # ssh collects IdentityFile from every matching block, so a host in two
    # items gets both keys offered and the server takes whichever it knows first.
    for h in "${words[@]}"; do
      if [[ -n ${host_owner[$h]:-} && ${host_owner[$h]} != "$label" ]]; then
        warn "Host $h is in both ${host_owner[$h]} and $label, so ssh offers both keys there; give one an alias of its own (hosts=github-work hostname=github.com)"
      else
        host_owner[$h]="$label"
      fi
    done
    block="# $label ($fp)"$'\n'"Host $hosts"$'\n'
    [[ -n $host_name ]] && block+="  HostName $host_name"$'\n'
    [[ -n $user ]] && block+="  User $user"$'\n'
    [[ -n $port ]] && block+="  Port $port"$'\n'
    block+="  IdentityAgent $AGENT_SOCK"$'\n'
    block+="  IdentityFile $SSH_DIR/$file.pub"$'\n'
    block+="  IdentitiesOnly yes"$'\n'
    conf+="$block"$'\n'
    info "Host $hosts"
    with_block+=("$label")
  done

  {
    printf '# Generated by dot-bw-setup from the Bitwarden SSH keys in %s. Do not edit:\n' "$SCOPE"
    printf '# change the vault, then run dot-bw-setup --refresh. The keys stay in the\n'
    printf '# vault; IdentityFile names the public key so the agent offers that one.\n\n'
    printf '%s' "$conf"
  } | write_file "$SSH_DIR/config.d/bitwarden" 0600 >/dev/null
  ok "~/.ssh/config.d/bitwarden ($(grep -c '^Host ' "$SSH_DIR/config.d/bitwarden" || true) Host block(s))"

  # .pub files this script wrote last time whose item is gone.
  if [[ -f $STATE_DIR/ssh-pubkeys ]]; then
    while IFS= read -r old; do
      [[ -n $old ]] || continue
      grep -qxF -- "$old" <<<"$managed_new" && continue
      rm -f "$SSH_DIR/$old"
      info "removed ~/.ssh/$old (no longer in the vault)"
    done <"$STATE_DIR/ssh-pubkeys"
  fi
  printf '%s' "$managed_new" >"$STATE_DIR/ssh-pubkeys"
  SUMMARY+=("ssh    $(grep -c . <<<"$managed_new" || true) public key(s), $(grep -c '^Host ' "$SSH_DIR/config.d/bitwarden" || true) Host block(s) in ~/.ssh/config.d/bitwarden")
  if ((${#with_block[@]})); then
    SUMMARY+=("       Host blocks: $(list "${with_block[@]}")")
  fi
  if ((${#key_only[@]})); then
    SUMMARY+=("       key only: $(list "${key_only[@]}"). A 'hosts' field (hosts=example.com) gives a key its Host block")
  fi
}

# --- git signing ----------------------------------------------------------------
setup_git() {
  local items="$1" signers sign_item="" name file pub emails email allowed=""
  local -a marked=()
  step "git: commit signing with an SSH key from the vault"
  signers="$(jq -c '[.[] | select([.fields[]? | select(.name == "signing")] | length > 0)]' <<<"$items")"
  local n i item v
  n="$(jq length <<<"$signers")"
  emails="$(gitcfg --get user.email || true)"
  for ((i = 0; i < n; i++)); do
    item="$(jq -c ".[$i]" <<<"$signers")"
    v="$(field "$item" signing)"
    pub="$(jq -r '.publicKey // ""' <<<"$item")"
    [[ -n $pub ]] || continue
    if truthy "$v"; then
      marked+=("$(key_label "$item")")
      [[ -n $sign_item ]] || sign_item="$item"
    elif [[ ${v,,} != verify ]]; then
      continue
    fi
    # allowed_signers: this key for your git email(s) (+ the item's 'emails').
    for email in $emails $(field "$item" emails | tr ',' ' '); do
      [[ $email =~ ^[^[:space:]\"]+@[^[:space:]\"]+$ ]] || continue
      allowed+="$email namespaces=\"git\" $pub"$'\n'
    done
  done
  if [[ -z $sign_item ]]; then
    warn "no SSH key in $SCOPE has the field signing=true: commits stay unsigned"
    rm -f "$GIT_DIR_OUT/signing.gitconfig"
    SUMMARY+=("git    no signing key (add a field signing=true to one SSH key item)")
    return
  fi
  name="$(key_label "$sign_item")"
  if ((${#marked[@]} > 1)); then
    warn "${#marked[@]} SSH keys have signing=true: $(list "${marked[@]}"). Signing with the oldest, $name; set signing=verify on the others"
  fi
  file="$(jq -r .file <<<"$sign_item")"
  pub="$(jq -r .publicKey <<<"$sign_item")"
  if [[ ! -f $SSH_DIR/$file.pub || "$(cut -d' ' -f1,2 "$SSH_DIR/$file.pub")" != "$pub" ]]; then
    warn "~/.ssh/$file.pub isn't the key of $name (run with ssh too)"
    return
  fi
  [[ -n $allowed ]] || warn "no email for allowed_signers: set user.email in config/git/config"
  printf '%s' "$allowed" | write_file "$GIT_DIR_OUT/allowed_signers" 0644 >/dev/null
  {
    printf '# Generated by dot-bw-setup from the Bitwarden SSH key %s. Do not edit.\n' "$name"
    printf '# Included by config/git/config. git signs through the agent in SSH_AUTH_SOCK.\n'
    printf '[user]\n\tsigningKey = %s\n' "$SSH_DIR/$file.pub"
    printf '[gpg]\n\tformat = ssh\n'
    printf '[gpg "ssh"]\n\tallowedSignersFile = %s\n' "$GIT_DIR_OUT/allowed_signers"
    printf '[commit]\n\tgpgSign = true\n'
  } | write_file "$GIT_DIR_OUT/signing.gitconfig" 0644 >/dev/null
  if gitcfg --get-all include.path | grep -q 'git-bitwarden/signing.gitconfig'; then
    ok "signing with ~/.ssh/$file.pub ($name); git config includes it"
  else
    warn "config/git/config doesn't include ~/.config/git-bitwarden/signing.gitconfig"
  fi
  ok "allowed signers: $(grep -c . "$GIT_DIR_OUT/allowed_signers" || true) line(s)"
  SUMMARY+=("git    commits signed with $name (~/.ssh/$file.pub)")
}

# --- gh -------------------------------------------------------------------------
setup_gh() {
  local token="$1" host="$2" current status
  step "gh: token from the vault into the system keyring"
  if [[ -z $token ]]; then
    info "no item \"gh-token\" in the vault; skipped (gh auth login works by hand too)"
    SUMMARY+=("gh     no gh-token item, skipped")
    return
  fi
  command -v gh >/dev/null || { warn "gh not installed"; return; }
  current="$(gh auth token --hostname "$host" 2>/dev/null || true)"
  if [[ -n $current && $current == "$token" ]]; then
    ok "gh already uses this token for $host"
  else
    # gh stores the token in the Secret Service keyring; with no keyring it
    # would fall back to plaintext ~/.config/gh/hosts.yml, checked below.
    if ! printf '%s' "$token" | gh auth login --hostname "$host" --git-protocol ssh --with-token; then
      warn "gh auth login failed (token revoked or missing scopes? gh needs repo, read:org)"
      SUMMARY+=("gh     login FAILED for $host")
      return
    fi
  fi
  status="$(gh auth status --hostname "$host" 2>&1 || true)"
  if grep -q '(keyring)' <<<"$status"; then
    ok "gh logged in to $host, token in the keyring"
    SUMMARY+=("gh     logged in to $host (token in the keyring)")
  else
    gh auth logout --hostname "$host" >/dev/null 2>&1 || true
    warn "gh had no keyring and wrote the token to a file: logged out again. Is gnome-keyring running?"
    SUMMARY+=("gh     NOT set up: no Secret Service keyring")
  fi
}

# --- env ------------------------------------------------------------------------
setup_env() {
  local vault="$1" out
  step "Project env: vault -> GNOME keyring (dot-bwenv)"
  command -v dot-bwenv >/dev/null || { warn "dot-bwenv not on PATH (home-manager switch?)"; return; }
  out="$(dot-bwenv import --prune <<<"$vault")" || { warn "dot-bwenv import failed (keyring locked or missing?)"; return; }
  if [[ -z $out ]]; then
    info "no env/<project> folders and no bwenv fields in the vault"
    SUMMARY+=("env    no projects in the vault")
    return
  fi
  printf '%s\n' "$out"
  SUMMARY+=("env    $(grep -c . <<<"$out") project(s) in the keyring: $(awk '{print $1}' <<<"$out" | xargs)")
}

# --- agent ----------------------------------------------------------------------
check_agent() {
  local fps="$1" listed rc=0 want missing=0
  step "Bitwarden desktop SSH agent ($AGENT_SOCK)"
  if [[ ! -S $AGENT_SOCK ]]; then
    warn "no agent socket. Start Bitwarden desktop, log in, then Settings -> SSH agent -> turn on \"Enable SSH agent\" (off by default; the app has no config-file switch for it)."
    SUMMARY+=("agent  NOT running: start Bitwarden desktop and enable its SSH agent")
    return
  fi
  listed="$(SSH_AUTH_SOCK="$AGENT_SOCK" timeout 20 ssh-add -l -E sha256 2>&1)" || rc=$?
  case "$rc" in
    0)
      for want in $fps; do
        grep -qF -- "$want" <<<"$listed" || { warn "agent doesn't offer $want (vault not synced in the app?)"; missing=1; }
      done
      ok "agent answers with $(grep -c . <<<"$listed") key(s)"
      ((missing)) || SUMMARY+=("agent  running, serves every SSH key in $SCOPE")
      ((missing)) && SUMMARY+=("agent  running, but some vault keys are missing (sync the desktop app)")
      ;;
    1)
      warn "agent has no keys: unlock Bitwarden desktop (keys load after the first unlock)"
      SUMMARY+=("agent  running, vault locked in the desktop app")
      ;;
    *)
      warn "agent socket doesn't answer: restart Bitwarden desktop"
      SUMMARY+=("agent  socket dead: restart Bitwarden desktop")
      ;;
  esac
  if [[ ${SSH_AUTH_SOCK:-} != "$AGENT_SOCK" ]]; then
    warn "SSH_AUTH_SOCK is '${SSH_AUTH_SOCK:-}', not the Bitwarden agent: log out and in after home-manager switch"
  fi
}

# --- main -----------------------------------------------------------------------
FOLDER="$(conf_get folder)"
SCOPE="your vault"
[[ -z $FOLDER ]] || SCOPE="the folder \"$FOLDER\""
for t in jq ssh-add ssh-keygen git; do command -v "$t" >/dev/null || die "$t not found"; done

if ((CHECK)); then
  fps=""
  if [[ -f $STATE_DIR/ssh-pubkeys ]]; then
    while IFS= read -r f; do
      [[ -f $SSH_DIR/$f ]] && fps+="$(ssh-keygen -lf "$SSH_DIR/$f" | awk '{print $2}') "
    done <"$STATE_DIR/ssh-pubkeys"
  fi
  check_agent "$fps"
  for f in "$SSH_DIR/config.d/bitwarden" "$GIT_DIR_OUT/signing.gitconfig"; do
    if [[ -f $f ]]; then SUMMARY+=("file   ${f/#$HOME/\~}"); else SUMMARY+=("file   ${f/#$HOME/\~} missing"); fi
  done
  command -v dot-bwenv >/dev/null && SUMMARY+=("env    $(dot-bwenv list 2>/dev/null | cut -d: -f1 | xargs)")
else
  command -v bw >/dev/null || die "bw not found: run system/70-bitwarden.sh"
  if want env || want gh; then
    command -v secret-tool >/dev/null || die "secret-tool not found: run system/70-bitwarden.sh"
  fi
  bw_login_unlock

  step "Reading the vault"
  bwq sync >/dev/null || die "bw sync failed"
  folders="$(bwq list folders | jq -c '[.[] | {id, name}]')"
  folder_id=""
  if [[ -n $FOLDER ]]; then
    folder_id="$(jq -r --arg n "$FOLDER" '[.[] | select(.name == $n) | .id][0] // ""' <<<"$folders")"
    if [[ -z $folder_id ]]; then
      warn "no folder \"$FOLDER\" in the vault (folder= in ~/.config/dot-bw/config): using every SSH key in the vault"
      SCOPE="your vault"
    fi
  fi
  # One `bw list items` for everything. Only what's needed leaves this
  # pipeline: public keys, fingerprints, custom fields, and the gh token. SSH
  # private keys and every other password are dropped here. Folder names are
  # not secret, so they may go in argv.
  items="$(bwq list items | jq -c --argjson folders "$folders" '
    ([$folders[] | select((.id // "") != "") | {(.id): .name}] | add // {}) as $names
    | [.[] | {
      id, name, type, folderId, folder: ($names[.folderId // ""] // "no folder"), created: (.creationDate // ""),
      fields: (.fields // []),
      publicKey: (.sshKey.publicKey // null), fingerprint: (.sshKey.keyFingerprint // null),
      token: (if .name == "gh-token"
              then (.login.password // ([.fields[]? | select(.name == "token") | .value][0]) // null)
              else null end)}]')" || die "bw list items failed"
  SESSION=""   # not needed past this point
  ssh_items="$(jq -c --arg f "$folder_id" \
    '[.[] | select(.type == 5 and ($f == "" or .folderId == $f))] | sort_by(.created, .id)' <<<"$items")"
  ok "$(jq length <<<"$items") items, $(jq length <<<"$ssh_items") SSH key(s) in $SCOPE"
  name_pub_files

  want ssh && setup_ssh "$ssh_items"
  want git && setup_git "$ssh_items"
  if want gh; then
    if (("$(jq '[.[] | select(.token != null)] | length' <<<"$items")" > 1)); then
      warn "more than one item \"gh-token\" in the vault; gh gets the first"
    fi
    gh_item="$(jq -c '[.[] | select(.token != null)][0] // {}' <<<"$items")"
    gh_host="$(field "$gh_item" host)"
    setup_gh "$(jq -r '.token // ""' <<<"$gh_item")" "${gh_host:-github.com}"
  fi
  if want env; then
    # stdin, not argv: field values are secrets.
    vault="$(printf '%s\n%s\n' "$folders" "$items" | jq -cs '{folders: .[0], items: [.[1][] | {name, folderId, fields}]}')"
    setup_env "$vault"
  fi
  check_agent "$(jq -r '.[].fingerprint // empty' <<<"$ssh_items")"
fi

step "Summary"
for line in "${SUMMARY[@]}"; do info "$line"; done
if ((${#WARNINGS[@]})); then
  printf '\n%s  %d thing(s) need you:%s\n' "$C_WARN" "${#WARNINGS[@]}" "$C_OFF"
  for line in "${WARNINGS[@]}"; do info "- $line"; done
else
  printf '\n%s  all done, nothing needs you%s\n' "$C_OK" "$C_OFF"
fi
info ""
info "Re-run after vault changes: dot-bw-setup --refresh. In a project: echo 'use bwenv <project>' >> .envrc"
