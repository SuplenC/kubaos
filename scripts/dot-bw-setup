#!/usr/bin/env bash
# dot-bw-setup: the old name of `kubaos bitwarden`, kept for one release so
# habits and old notes keep working. It says the new name, then runs it.
#
#   dot-bw-setup [--server URL] [--login M] [--only L]  kubaos bitwarden setup ...
#   dot-bw-setup --refresh [--only L]                   kubaos bitwarden refresh ...
#   dot-bw-setup --check                                kubaos bitwarden check
set -euo pipefail

cmd=setup
args=()
for a in "$@"; do
  case "$a" in
    --refresh) cmd=refresh ;;
    --check) cmd=check ;;
    *) args+=("$a") ;;
  esac
done

printf 'dot-bw-setup is now: kubaos bitwarden %s\n' "$cmd" >&2
exec kubaos bitwarden "$cmd" "${args[@]}"
