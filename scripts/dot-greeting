#!/usr/bin/env bash
# dot-greeting: the fastfetch greeting a new Ghostty window shows
# (home/shell.nix). On unless ~/.config/kubaos/zsh/no-greeting exists; a
# file, so zsh reads the setting with one stat and no parser.
#
#   dot-greeting on       show it in every new Ghostty window
#   dot-greeting off      never show it
#   dot-greeting status   print on or off
#   dot-greeting show     show it here, now
#
# KUBAOS_GREETING=0 in the environment turns it off as well, whatever the
# setting says. The change applies to windows opened after it.
set -euo pipefail

off="${XDG_CONFIG_HOME:-$HOME/.config}/kubaos/zsh/no-greeting"

usage() { sed -n '2,/^set -euo/{/^set -euo/d; s/^# \{0,1\}//p;}' "$0"; }

case "${1:-}" in
  on) rm -f -- "$off" ;;
  off)
    mkdir -p -- "$(dirname -- "$off")"
    : >"$off"
    ;;
  status) if [[ -e $off ]]; then echo off; else echo on; fi ;;
  show) exec fastfetch --config "${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/greeting.jsonc" ;;
  -h | --help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
