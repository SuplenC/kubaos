#!/usr/bin/env bash
# Long-running helper started from config/hypr/autostart.lua.
#
# Listens on Hyprland's event socket. When a monitor is added (dock plugged
# back in), moves every numbered workspace that has a monitor rule back to
# that monitor (4-6 to external 1, 7-9 to external 2). The rules are read
# from Hyprland (`hyprctl -j workspacerules`), so workspaces.lua stays the
# only place that defines them. On monitor add/remove it also re-runs
# `dot-hypr-lid sync`, so the laptop panel comes back on when the last
# external disappears with the lid closed.
#
# Hyprland 0.56 already moves *persistent* workspaces back to their rule's
# monitor on connect (WorkspacePlacementController), so the restore pass is
# a safety net; it is a no-op when Hyprland got there first.
#
# Battery: grep filters the event stream, so this script only wakes up for
# monitor events (Hyprland sends one event per focus/title change).
#
# Needs: socat, grep (apt), jq (Nix, home/cli.nix), hyprctl.
set -euo pipefail

: "${HYPRLAND_INSTANCE_SIGNATURE:?not running inside Hyprland}"
: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}"

socket="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
state_dir="$XDG_RUNTIME_DIR/dot-hypr"
mkdir -p "$state_dir"

# One instance per Hyprland session.
exec 9>"$state_dir/workspaces-$HYPRLAND_INSTANCE_SIGNATURE.lock"
flock -n 9 || exit 0

# Hyprland sends stdout/stderr of what it spawns to /dev/null; run the script
# from a terminal to see this.
log() { printf 'dot-hypr-workspaces: %s\n' "$*" >&2; }

# Prints "<workspace> <monitor-name>" for each workspace that is not on the
# monitor its rule asks for, when that monitor is connected. A rule monitor is
# either a connector name or "desc:<prefix of the description>".
pending_moves() {
  jq -rn \
    --argjson rules "$(hyprctl -j workspacerules)" \
    --argjson mons "$(hyprctl -j monitors)" \
    --argjson wss "$(hyprctl -j workspaces)" '
    def target($sel):
      if ($sel | startswith("desc:"))
      then ($sel[5:] | ltrimstr(" ")) as $d | first($mons[] | select(.description | startswith($d)))
      else first($mons[] | select(.name == $sel))
      end;
    $rules[]
    | select((.monitor // "") != "" and (.workspaceString | test("^[0-9]+$")))
    | .workspaceString as $ws
    | (try target(.monitor) catch null) as $mon
    | select($mon != null)
    | (first($wss[] | select((.id | tostring) == $ws)) // null) as $cur
    | select($cur != null and $cur.monitor != $mon.name)
    | "\($ws) \($mon.name)"'
}

restore() {
  local ws mon moves
  moves=$(pending_moves) || { log "could not read Hyprland state"; return 0; }
  while read -r ws mon; do
    [[ -n ${ws:-} ]] || continue
    log "workspace $ws -> $mon"
    hyprctl dispatch "hl.dsp.workspace.move({ workspace = \"$ws\", monitor = \"$mon\" })" >/dev/null || true
  done <<<"$moves"
}

on_monitor_change() {
  dot-hypr-lid sync || log "dot-hypr-lid sync failed"
  restore
}

# Monitor events only, v2 (Hyprland sends v1 and v2 of each).
listen() {
  socat -U - "UNIX-CONNECT:$socket" | grep --line-buffered -E '^monitor(added|removed)v2>>'
}

delay=1
while true; do
  [[ -S $socket ]] || { log "event socket gone, exiting"; exit 0; }
  exec 3< <(listen)

  # (Re)connected: catch up on whatever changed while not listening. On the
  # first pass this covers logging in with the dock already plugged in.
  sleep 1
  on_monitor_change </dev/null

  while read -r -u 3 _; do
    delay=1
    # Give Hyprland a moment to configure the outputs, then fold the rest of
    # the burst (a dock brings both externals at once) into one pass.
    sleep 1
    while read -r -t 0.2 -u 3 _; do :; done
    on_monitor_change </dev/null
  done
  exec 3<&-

  # Connection lost. Exit with Hyprland; otherwise retry with backoff.
  hyprctl version >/dev/null 2>&1 || { log "Hyprland is gone, exiting"; exit 0; }
  log "event socket closed, reconnecting in ${delay}s"
  sleep "$delay"
  ((delay < 30)) && delay=$((delay * 2))
done
