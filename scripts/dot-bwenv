#!/usr/bin/env bash
# dot-bwenv: the old name of `kubaos bitwarden env`, kept for one release so
# habits and old notes keep working. It says the new name, then runs it.
#
#   dot-bwenv pull|refresh|list|clear ...   kubaos bitwarden env pull|refresh|list|clear ...
#   dot-bwenv env <project>                 kubaos bitwarden env export <project>
set -euo pipefail

cmd="${1:-}"
(($#)) && shift
case "$cmd" in
  "" | -h | --help | help) exec kubaos bitwarden env --help ;;
  env) cmd="export" ;;
esac

printf 'dot-bwenv is now: kubaos bitwarden env %s\n' "$cmd" >&2
exec kubaos bitwarden env "$cmd" "$@"
