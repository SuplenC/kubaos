#!/usr/bin/env bash
# Screenshot to clipboard and file.
#
#   dot-hypr-screenshot region   freeze the screen, select an area with slurp (Esc cancels)
#   dot-hypr-screenshot output   the focused monitor
#   dot-hypr-screenshot window   the active window
#   dot-hypr-screenshot MODE --edit   then open it in satty to annotate
#   dot-hypr-screenshot edit FILE     open an existing image in satty
#
# Saves to $DOT_SCREENSHOT_DIR or ~/Pictures/Screenshots, copies the PNG to
# the clipboard, and sends a notification with an "Edit" action. satty saves
# the annotated copy next to the original (<name>-annotated.png) and copies
# it to the clipboard (Enter or Ctrl+C; Ctrl+S saves).
#
# A region shot freezes the screen the moment the key is pressed, as macOS does: what moves, or
# shows only while focused (a menu, a hover), stays as it was, and the shot is that frozen frame.
# The freeze ends with the selection, on Esc and on any error.
#
# Every shot is a PNG at zlib level 1: a fifth larger than grim's default, and four times faster
# to write, about 60 ms for a quarter of the panel and 340 ms for all of it, against 1.4 s.
# Needs: grim, slurp, wl-clipboard, socat (apt), hyprpicker, jq, satty (Nix), hyprctl.
set -euo pipefail

# satty runs the copy command through `sh -c` and writes a PNG to its stdin. wl-copy without a type
# guesses it with `file`, which is not installed, and falls back to text/plain.
edit() {
  satty --filename "$1" --output-filename "${1%.*}-annotated.png" \
    --copy-command 'wl-copy --type image/png' --actions-on-enter save-to-clipboard,save-to-file --early-exit
}

# Waits for $2 events `$1` on Hyprland's event stream (fd 3), giving up after 2 s without one:
# the shot then comes a moment late, not missing.
await() {
  local seen=0 line
  while ((seen < $2)) && read -r -t 2 line <&3; do
    [[ $line != "$1" ]] || seen=$((seen + 1))
  done
}

# Freezes the screen, lets the selection be made on the frozen frame and shoots it into $file
# (`destination`); exits 0 on Esc. The trap ends the freeze and the event stream however the script ends.
#
# The shot is taken once slurp is gone and the freeze is all that's left on screen: hyprpicker
# draws its copy of the screen pixel for pixel, fractional scale included, and nothing over it with
# --no-zoom, so `grim -g` shoots the frozen frame, and only the selection, the fastest way there
# is. Nothing waits on a capture before the selection starts.
#
# HAZARD: wait for Hyprland's `openlayer>>hyprpicker` before slurp starts and
# `closelayer>>selection` before the shot, one a monitor. `hyprctl layers` lists a layer from its
# creation, before it shows anything. And neither layer is animated (config/hypr/rules.lua): a
# shot taken while the freeze fades in has the live screen in it, and one taken while slurp fades
# out has its box.
capture_region() {
  local geometry want
  # Listening before hyprpicker starts, so no map is missed.
  exec 3< <(exec socat -U - "UNIX-CONNECT:${XDG_RUNTIME_DIR:-}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket2.sock")
  events=$!
  trap '[[ -z $picker ]] || kill "$picker" 2>/dev/null || true; [[ -z $events ]] || kill "$events" 2>/dev/null || true' EXIT
  hyprpicker --render-inactive --no-zoom --quiet >/dev/null 2>&1 &
  picker=$!
  want=$(hyprctl -j monitors | jq length)
  await 'openlayer>>hyprpicker' "$want"
  geometry=$(slurp -d) || exit 0
  destination
  await 'closelayer>>selection' "$want"
  grim -l 1 -g "$geometry" "$file"
}

picker=
events=
file=
mode=${1:-region}
if [[ $mode == edit ]]; then
  [[ -f ${2:-} ]] || { echo "usage: $(basename "$0") edit FILE" >&2; exit 2; }
  edit "$2"
  exit
fi
annotate=0
[[ ${2:-} == --edit ]] && annotate=1
# Named for the moment the key was pressed; the folder is looked up only once the region's freeze
# is up, so nothing stands before it.
printf -v stamp '%(%Y-%m-%d_%H-%M-%S)T' -1

# Sets $file in the screenshots folder, making the folder.
destination() {
  local pictures dir
  pictures=$(xdg-user-dir PICTURES 2>/dev/null || true)
  # xdg-user-dir prints $HOME when PICTURES is not configured.
  [[ $pictures == "$HOME" ]] && pictures=
  dir=${DOT_SCREENSHOT_DIR:-${pictures:-$HOME/Pictures}/Screenshots}
  mkdir -p "$dir"
  file="$dir/Screenshot_$stamp.png"
}

case "$mode" in
  region)
    capture_region
    ;;
  output)
    destination
    monitor=$(hyprctl -j activeworkspace | jq -r '.monitor')
    grim -l 1 -o "$monitor" "$file"
    ;;
  window)
    destination
    geometry=$(hyprctl -j activewindow | jq -r 'select(.at != null) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
    [[ -n $geometry ]] || { echo "no active window to shoot" >&2; exit 1; }
    grim -l 1 -g "$geometry" "$file"
    ;;
  *)
    echo "usage: $(basename "$0") region|output|window [--edit] | edit FILE" >&2
    exit 2
    ;;
esac

wl-copy --type image/png <"$file"

if ((annotate)); then
  edit "$file"
  exit
fi

if command -v notify-send >/dev/null 2>&1; then
  # The notification waits for its action in the background, so the bind returns.
  (
    action=$(notify-send -a Screenshot -i "$file" --action=edit=Edit "Copied. Evidence secured." "${file/#$HOME/\~}" || true)
    [[ $action != edit ]] || edit "$file"
  ) </dev/null >/dev/null 2>&1 &
  disown
else
  hyprctl notify -1 3000 'rgb(c2c1ff)' "Copied. Evidence secured: ${file/#$HOME/\~}" >/dev/null || true
fi
