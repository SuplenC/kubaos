#!/usr/bin/env bash
# dot-session: bring the running session onto the defaults a home-manager
# switch has just linked. A switch writes no file: it points ~/.config's links
# at new store files. Quickshell, hypridle, Ghostty and tmux read their config
# when they start, and Hyprland only notices a config file written in place.
#
#   dot-session apply OLD NEW   compare the records (`kubaos-session`, from
#                               home/session.nix) of generations OLD and NEW;
#                               for each part that changed, reload Hyprland,
#                               restart Quickshell or hypridle inside it, and
#                               reload Ghostty or tmux. Home activation runs it.
#   dot-session shell           in the session: run Quickshell, its log in the
#                               journal (`journalctl --user -t quickshell`),
#                               and start it again whenever it dies, until a
#                               `qs kill` or the end of the session. Hyprland's
#                               autostart runs it.
#   dot-session restart-shell   in the session: restart the default Quickshell
#                               once the screen is unlocked
#   dot-session restart-idle    in the session: restart hypridle, if it runs
#   dot-session start-idle      in the session: restart hypridle, or start it if it
#                               isn't running. `kubaos-idle` runs it after a change
#   dot-session leave logout|reboot|poweroff
#                               in the session: stop graphical-session.target
#                               and wait for it, then end the session, reboot
#                               or power off. The power menu runs it.
#
# It only touches what runs: with no Hyprland, no shell or no tmux server there
# is nothing to do. A Quickshell or hypridle the user stopped stays stopped.
# `apply` always exits 0, so it never fails a switch.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
SUPERVISOR_LOCK="$RUNTIME/dot-session-shell-supervisor.lock"
# The order `apply` takes them in: Hyprland's reload first, so a shell
# restarted in it starts under the new rules.
PARTS=(hyprland quickshell hypridle ghostty tmux)

say() { printf 'dot-session: %s\n' "$*"; }

usage() {
  sed -n '2,/^set -euo/{/^set -euo/d; s/^# \{0,1\}//p}' "${BASH_SOURCE[0]}"
}

# record GEN PART: the store paths PART started from in generation GEN, empty
# when GEN has no record.
record() {
  sed -n "s/^$2 //p" "$1/kubaos-session" 2>/dev/null || true
}

# hypr_instances: the signature of each Hyprland running as this user.
hypr_instances() {
  command -v hyprctl >/dev/null || return 0
  hyprctl instances -j 2>/dev/null | jq -r '.[].instance' 2>/dev/null || true
}

# in_hyprland INSTANCE ARGS...: this script with ARGS, started by Hyprland, so
# it gets the session's environment and outlives the switch (a switch from
# `kubaos update` runs in a systemd unit that stops when it is done).
in_hyprland() {
  local instance="$1"
  shift
  hyprctl -i "$instance" dispatch "hl.dsp.exec_cmd([[bash '$SELF' $*]])" >/dev/null 2>&1
}

reload_ghostty() {
  # Ghostty (GTK, 1.2+) reloads its config on SIGUSR2. Only the exact process
  # names: SIGUSR2 kills a process that does not handle it. The Nix wrapper
  # shows as ".ghostty-wrapped", cut to 15 characters.
  local pids
  pids=$(pgrep -u "$(id -u)" -x 'ghostty|\.ghostty-wrappe|\.ghostty-wrapped' || true)
  [[ -n $pids ]] || return 0
  # shellcheck disable=SC2086 # One argument per pid.
  kill -USR2 $pids 2>/dev/null && say "reloaded Ghostty"
}

reload_tmux() {
  command -v tmux >/dev/null || return 0
  tmux has-session 2>/dev/null || return 0
  tmux source-file -q "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf" >/dev/null 2>&1 &&
    say "reloaded tmux"
}

apply() {
  local old="$1" new="$2" part instance changed=()
  for part in "${PARTS[@]}"; do
    [[ $(record "$old" "$part") == "$(record "$new" "$part")" ]] || changed+=("$part")
  done
  ((${#changed[@]})) || return 0

  local instances=()
  mapfile -t instances < <(hypr_instances)
  for part in "${changed[@]}"; do
    case "$part" in
      hyprland)
        for instance in "${instances[@]}"; do
          hyprctl -i "$instance" reload >/dev/null 2>&1 && say "reloaded Hyprland"
        done
        ;;
      quickshell)
        for instance in "${instances[@]}"; do
          in_hyprland "$instance" restart-shell && say "restarting Quickshell"
        done
        ;;
      hypridle)
        for instance in "${instances[@]}"; do
          in_hyprland "$instance" restart-idle && say "restarting hypridle, if it runs"
        done
        ;;
      ghostty) reload_ghostty ;;
      tmux) reload_tmux ;;
    esac
  done
}

# wait_gone CMD...: until CMD fails, for up to 5 s.
wait_gone() {
  local _
  for _ in $(seq 50); do
    "$@" >/dev/null 2>&1 || return 0
    sleep 0.1
  done
}

# shell: Quickshell under a supervisor. Quickshell's own crash handler
# restarts a shell that crashes on a signal, in the same process tree, so this
# loop only sees the deaths it misses: an exit on a lost Wayland connection
# (Qt's `_exit`, no crash report), a crash in the first 10 s, a kill. A shell
# that dies with the screen locked locks again as it starts
# (`config/quickshell/services/Session.qml`).
run_shell() {
  exec 8>"$SUPERVISOR_LOCK"
  flock -n 8 || { say "a shell supervisor already runs" >&2; exit 1; }
  # Into the journal when journald runs; where it doesn't (the test
  # harness), the output stays wherever this script's went.
  if [[ -S /run/systemd/journal/stdout ]] && command -v systemd-cat >/dev/null; then
    exec > >(systemd-cat -t quickshell 8>&-) 2>&1
  fi
  local delay=0 started rc
  while :; do
    started=$SECONDS
    rc=0
    qs --no-color 8>&- || rc=$?
    ((rc == 0)) && return 0
    # The compositor is gone: the session ended, so has the shell.
    [[ -n ${WAYLAND_DISPLAY:-} && -S $RUNTIME/$WAYLAND_DISPLAY ]] || return 0
    # Back off while it keeps dying as it starts, up to 30 s between tries.
    if ((SECONDS - started < 10)); then
      delay=$((delay == 0 ? 1 : delay * 2 > 30 ? 30 : delay * 2))
    else
      delay=0
    fi
    say "Quickshell exited with status $rc, starting it again in ${delay}s"
    sleep "$delay"
  done
}

# supervised: whether `dot-session shell` runs, by the lock it holds.
supervised() {
  ! flock -n "$SUPERVISOR_LOCK" true
}

restart_shell() {
  exec 9>"$RUNTIME/dot-session-shell.lock"
  # A restart already waiting starts the newest config anyway.
  flock -n 9 || return 0
  # A shell stopped while locked leaves Hyprland locked with no lock screen.
  # A shell too old to answer is taken as unlocked.
  while [[ $(qs ipc call session locked 2>/dev/null) == true ]]; do
    sleep 2
  done
  # Every Quickshell, by process: `qs kill` reaches one instance, and the
  # crash handler it runs under relaunches the shell it sees die, so a kill by
  # instance leaves one shell running beside the new one.
  pkill -u "$(id -u)" -x .quickshell-wra || return 0
  # `dot-session shell` starts the new one.
  supervised && return 0
  wait_gone pgrep -u "$(id -u)" -x .quickshell-wra
  # HAZARD: close the lock before exec. Quickshell would hold it for as long
  # as it runs, and every later restart would skip.
  exec 9>&-
  exec qs
}

restart_idle() {
  pkill -u "$(id -u)" -x hypridle || return 0
  wait_gone pgrep -u "$(id -u)" -x hypridle
  exec hypridle
}

start_idle() {
  if pkill -u "$(id -u)" -x hypridle; then
    wait_gone pgrep -u "$(id -u)" -x hypridle
  fi
  exec hypridle
}

# leave ACTION: the session's units (the portals, the polkit agent, Ghostty)
# stop while Hyprland still answers them, and only then does the session end.
# Hyprland gone first, they lose the display and die with an error, and the
# shutdown waits on whatever was still stopping. The stop is bounded: the
# power menu must work even when a unit won't stop.
leave() {
  timeout 15 systemctl --user stop graphical-session.target || true
  case "$1" in
    logout) exec loginctl terminate-session "${XDG_SESSION_ID:-}" ;;
    reboot | poweroff) exec systemctl "$1" ;;
  esac
}

case "${1:-}" in
  apply)
    (($# == 3)) || { usage >&2; exit 2; }
    apply "$2" "$3" || true
    ;;
  shell) run_shell ;;
  restart-shell) restart_shell ;;
  restart-idle) restart_idle ;;
  start-idle) start_idle ;;
  leave)
    [[ $# == 2 && $2 =~ ^(logout|reboot|poweroff)$ ]] || { usage >&2; exit 2; }
    leave "$2"
    ;;
  -h | --help) usage ;;
  *) usage >&2; exit 2 ;;
esac
