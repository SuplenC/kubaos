#!/usr/bin/env bash
# In-container entry point for test/run (runs as root in the dotfiles-test
# image, the repo under test at /src). Not meant to be run by hand.
set -euo pipefail
LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=test/lib/harness.sh
. "$LIB/harness.sh"
# shellcheck source=test/lib/session.sh
. "$LIB/session.sh"

cmd="${1:-}"
shift || true

case "$cmd" in
  warm)
    # Realise everything the tests need into the dotfiles-nix volume, with GC
    # roots in the cache volume, so later runs only build what changed.
    t0="$(now)"
    start_nix_daemon
    boot_like
    trust_local_inputs
    link_caches
    copy_repo
    install -d -o "$USER_NAME" -g "$USER_NAME" "$CACHE/roots"
    say "home-manager generation for $HM_CONFIG"
    as_user "$NIX_BIN/nix" build --out-link "$CACHE/roots/home" \
      "$REPO#homeConfigurations.\"$HM_CONFIG\".activationPackage"
    say "home-manager CLI, PAM modules, test tools (flake's nixpkgs)"
    for a in home-manager nixpkgs#fprintd nixpkgs#pam_u2f nixpkgs#pamtester nixpkgs#chromium; do
      as_user "$NIX_BIN/nix" build --out-link "$CACHE/roots/${a#nixpkgs#}" --inputs-from "$REPO" "$a"
    done
    if [[ ${1:-} == --hyprland ]]; then
      # TODO(lead): recipe from screenshot agent (which Hyprland, which substituter).
      die "warm --hyprland: the Hyprland recipe isn't in yet (test/Dockerfile, stage hyprland)"
    fi
    switch
    note "store: $(du -sh /nix/store 2>/dev/null | cut -f1)"
    say "warm in $(since "$t0") s, peak memory $(peak_memory)"
    ;;

  e2e)
    # shellcheck source=test/lib/e2e.sh
    . "$LIB/e2e.sh"
    t0="$(now)"
    prepare
    rc=0
    e2e_main "${1:-}" || rc=$?
    note "e2e total $(since "$t0") s, peak memory $(peak_memory)"
    exit "$rc"
    ;;

  shell)
    prepare
    say "login shell as $USER_NAME in $REPO (a copy: edits here are lost; edit on the host)"
    cd "$REPO"
    exec runuser -u "$USER_NAME" -- env -i "${JENV[@]}" zsh -l
    ;;

  bitwarden)
    # shellcheck source=test/lib/bitwarden.sh
    . "$LIB/bitwarden.sh"
    prepare
    bitwarden_main
    ;;

  shots-start)
    # shots-start COMPOSITOR SIZE SCALE WALLPAPER: session for screenshots;
    # stays up until `test/run shots stop`.
    compositor="$1" size="$2" scale="$3" wall="${4:-}"
    prepare
    session_start "$compositor" "$size" "$scale"
    if [[ -n $wall ]]; then
      # SET/FILE under /usr/share/kubaos/wallpapers.
      wall="/usr/share/kubaos/wallpapers/$wall"
      in_session "dot-theme set $wall" >"$LOGS/dot-theme.log" 2>&1 ||
        { cat "$LOGS/dot-theme.log"; die "dot-theme set $wall failed"; }
    fi
    qs_start || { tail -30 "$QS_LOG"; die "Quickshell didn't load"; }
    sleep 3
    touch "$LOGS/session-ready"
    say "session up: $compositor $size scale $scale; Quickshell log $QS_LOG"
    exec sleep infinity
    ;;

  shot)
    # shot NAME [--webp]: grim the whole output into /out.
    name="${1:?shot needs a name}"
    in_session "grim /out/$name.png"
    if [[ ${2:-} == --webp ]]; then
      as_user cwebp -quiet -q 92 -sharp_yuv "/out/$name.png" -o "/out/$name.webp"
      rm -f "/out/$name.png"
      echo "/out/$name.webp"
    else
      echo "/out/$name.png"
    fi
    ;;

  record-start)
    name="${1:?record-start needs a name}"
    in_session "nohup wf-recorder -y -f /out/$name.mp4 >$LOGS/wf-recorder.log 2>&1 & echo \$! >$RUNTIME_DIR/wf-recorder.pid"
    echo "/out/$name.mp4 (stop with: test/run shots record stop)"
    ;;

  record-stop)
    if [[ -f $RUNTIME_DIR/wf-recorder.pid ]]; then
      kill -INT "$(cat "$RUNTIME_DIR/wf-recorder.pid")" 2>/dev/null || true
      sleep 1
      rm -f "$RUNTIME_DIR/wf-recorder.pid"
    fi
    ;;

  run)
    # run CMD: CMD in kuba's session (qs ipc call ..., notify-send, ...).
    in_session "$*"
    ;;

  qs-log)
    cat "$QS_LOG"
    ;;

  *)
    die "unknown command '$cmd'"
    ;;
esac
