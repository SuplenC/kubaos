#!/usr/bin/env bash
# test/user-layer-check: proves the promise of the user layer (issue #9,
# docs/CONTRACTS.md "Defaults and the user layer"). Run as the user, on an
# installed system or in the test harness:
#
#   1. the install left every user file in ~/.config/kubaos, grouped by area,
#      and the defaults are read-only store files;
#   2. it puts a change in every user file, then puts the folders back in the
#      flat layout of older releases, ~/.config/kubaos/<app>, beside a few
#      untouched examples in the groups, as an update from one finds them;
#   3. it applies a newer defaults tree: a commit to a KubaOS checkout, then
#      home-manager switch, which is what an update does;
#   4. every user file is byte-identical and back in its group, the new
#      defaults are live, and the user's values win where both set one;
#   5. the update's migration and another apply change nothing.
#
#   test/user-layer-check          an installed system: commits to a clone of
#                                  /usr/share/kubaos, switches the user flake
#                                  (~/.config/kubaos/home) with KubaOS from it
#   test/user-layer-check REPO     a checkout: commits to REPO, switches its
#                                  own flake (the test harness)
#
# It leaves the user files changed (and commits to REPO): run it on a
# throwaway system. Prints ok/FAIL lines, exits 1 on the first failed step.
set -euo pipefail

U="${XDG_CONFIG_HOME:-$HOME/.config}/kubaos"
C="${XDG_CONFIG_HOME:-$HOME/.config}"
SKEL="${XDG_DATA_HOME:-$HOME/.local/share}/kubaos/skel"
PATH="$PATH:/nix/var/nix/profiles/default/bin"
HM_CONFIG="${HM_CONFIG:-$(id -un)@$(hostname -s)}"
if (($#)); then
  REPO=$1
  SWITCH=(--flake "$REPO#$HM_CONFIG")
else
  REPO="$(mktemp -d)/kubaos"
  git clone -q /usr/share/kubaos "$REPO"
  SWITCH=(--flake "$U/home#$HM_CONFIG" --override-input kubaos "git+file://$REPO")
fi

LAYER_GROUPS=(desktop terminal editor tools menu)
USER_FILES=(desktop/hypr/hyprland.lua desktop/hypr/hypridle.conf desktop/hypr/hyprlock.conf
  desktop/quickshell/settings.json desktop/cursor/cursor.toml desktop/keyboard/keyboard.toml
  desktop/clock/clock.toml desktop/sysmon/sysmon.toml desktop/idle/idle.toml
  desktop/workspaces/groups.toml
  terminal/tmux/tmux.conf terminal/foot/foot.ini terminal/ghostty/config terminal/fastfetch/config.jsonc
  terminal/fastfetch/greeting.jsonc
  terminal/zsh/zshrc
  editor/nvim/options.lua editor/nvim/keymaps.lua editor/nvim/autocmds.lua editor/nvim/plugins/example.lua
  editor/nvim/lazy-lock.json editor/nvim/lazyvim.json
  tools/git/config tools/git/ignore tools/fuzzel/fuzzel.ini tools/lazygit/config.yml tools/bacon/prefs.toml
  tools/bat/config tools/yazi/yazi.toml tools/yazi/keymap.toml
  menu/kotodama/user.toml)
# Files the app rewrites itself: copied from the defaults once, then the user's.
SEEDED=(btop/btop.conf tms/config.toml)

bad=0
fail() { echo "FAIL $*"; bad=1; }
step_done() { ((bad == 0)) || exit 1; echo "ok   $*"; }

hashes() {
  local f
  for f in "${USER_FILES[@]}"; do sha256sum "$U/$f"; done
  for f in "${SEEDED[@]}"; do sha256sum "$C/$f"; done
}
# add FILE TEXT: append a line, the way an editor would.
add() { printf '%s\n' "$2" >>"$1"; }
json_add() { jq '. + {"probe": "mine"}' "$1" >"$1.tmp" && mv "$1.tmp" "$1"; }

# 1. The install.
for f in "${USER_FILES[@]}"; do
  [[ -f $U/$f ]] || fail "the install left no $U/$f"
done
for f in "${SEEDED[@]}"; do
  [[ -f $C/$f && ! -L $C/$f ]] || fail "$C/$f isn't a plain file"
done
for f in hypr/hyprland.lua tmux/tmux.conf git/config ghostty/config nvim/init.lua lazygit/config.yml; do
  [[ "$(readlink -f "$C/$f")" == /nix/store/* ]] || fail "$C/$f isn't a store file"
done
step_done "${#USER_FILES[@]} user files and ${#SEEDED[@]} seeded files exist; defaults are store files"

# 2. The user changes every file.
add "$U/desktop/hypr/hyprland.lua" 'dot.user_probe = true'
add "$U/desktop/hypr/hypridle.conf" '# user probe'
add "$U/desktop/hypr/hyprlock.conf" '# user probe'
add "$U/terminal/tmux/tmux.conf" 'set -g @user_probe mine'
add "$U/tools/git/config" $'[kubaos]\n\tuserprobe = mine'
add "$U/tools/git/ignore" '*.userprobe'
add "$U/terminal/foot/foot.ini" $'[main]\npad=3x3'
add "$U/terminal/ghostty/config" 'font-size = 17'
add "$U/tools/fuzzel/fuzzel.ini" $'[main]\nlines=13'
add "$U/editor/nvim/options.lua" 'vim.g.user_probe = "mine"'
add "$U/editor/nvim/keymaps.lua" '-- user probe'
add "$U/editor/nvim/autocmds.lua" '-- user probe'
add "$U/editor/nvim/plugins/example.lua" '-- user probe'
json_add "$U/editor/nvim/lazy-lock.json"
json_add "$U/editor/nvim/lazyvim.json"
add "$U/tools/lazygit/config.yml" $'gui:\n  showFileTree: false'
add "$U/tools/bacon/prefs.toml" 'summary = true'
add "$U/tools/bat/config" '--tabs=7'
printf '%s\n' '// mine' '{ "display": { "separator": " => " } }' >"$U/terminal/fastfetch/config.jsonc"
add "$U/tools/yazi/yazi.toml" '# user probe'
add "$U/tools/yazi/keymap.toml" '# user probe'
add "$U/terminal/zsh/zshrc" "alias userprobe='echo mine'"
add "$U/menu/kotodama/user.toml" $'[extensions.apps.names]\nnvim = "Mine"'
printf '%s\n' '// mine' '{ "menuMotion": "fades" }' >"$U/desktop/quickshell/settings.json"
add "$U/desktop/cursor/cursor.toml" 'size = 32'
add "$U/desktop/keyboard/keyboard.toml" 'mac_accents = false'
add "$U/desktop/clock/clock.toml" 'analog = true'
add "$U/desktop/sysmon/sysmon.toml" 'style = "bars"'
add "$U/desktop/idle/idle.toml" $'[battery]\nlock = "2m"'
add "$U/desktop/workspaces/groups.toml" '# user probe'
add "$C/btop/btop.conf" 'update_ms = 1717'
add "$C/tms/config.toml" '# user probe'
before="$(hashes)"
step_done "changed $(wc -l <<<"$before") user files"

# The flat layout of older releases: every app's folder straight under the
# user layer, and no maps. Beside them, two examples as a newer release would
# have seeded them into the groups, untouched, which give way to the user's.
for group in "${LAYER_GROUPS[@]}"; do
  for d in "$U/$group"/*/; do
    d="${d%/}"
    [[ -e $d ]] && mv "$d" "$U/${d##*/}"
  done
  rm -rf "${U:?}/$group"
done
rm -f "$U/README.md"
install -D -m 644 "$SKEL/desktop/hypr/hypridle.conf" "$U/desktop/hypr/hypridle.conf"
install -D -m 644 "$SKEL/tools/git/ignore" "$U/tools/git/ignore"
[[ -f $U/hypr/hyprland.lua && -f $U/nvim/options.lua && -f $U/kotodama/user.toml ]] ||
  fail "couldn't put the user layer in the flat layout"
step_done "the user layer is in the flat layout, two untouched examples in the groups"

# 3. A newer defaults tree. New defaults go above the user layer's include,
# where a real change to an entry file goes; git's also sets a value the
# user overrode.
# (One && chain: errexit doesn't apply on the left of ||.)
(
  cd "$REPO" &&
    add config/tmux/tmux.conf 'set -g @kubaos_probe new' &&
    awk '/^# Your settings, last/ { print "[kubaos]\n\tdefaultprobe = new\n\tuserprobe = ours\n" } 1' \
      config/git/config >config/git/config.tmp &&
    mv config/git/config.tmp config/git/config &&
    add config/git/ignore '*.kubaosprobe' &&
    add config/bat/config '--wrap=never' &&
    add config/btop/btop.conf 'update_ms = 4242' &&
    add config/ghostty/config 'cursor-style = underline' &&
    add config/nvim/lua/config/options.lua 'vim.g.kubaos_probe = "new"' &&
    add config/kotodama/kubaos.toml $'\n[extensions.emoji]\nskin_tone = "medium"' &&
    git add -A &&
    git -c user.name=test -c user.email=test@kubaos -c commit.gpgsign=false commit -q -m 'test: newer defaults'
) || fail "couldn't commit the newer defaults"
out="$(home-manager switch -b hm-backup "${SWITCH[@]}" 2>&1)" ||
  { printf '%s\n' "$out" | tail -20; fail "home-manager switch onto the newer defaults"; }
step_done "home-manager switch onto the newer defaults"

# 4. Byte-identical, new defaults live, the user's values win.
after="$(hashes)"
if [[ $before != "$after" ]]; then
  diff <(printf '%s\n' "$before") <(printf '%s\n' "$after") || true
  fail "the update changed user files"
fi
step_done "$(wc -l <<<"$after") user files byte-identical after the update"

for d in "$U"/*/; do
  d="${d%/}" && d="${d##*/}"
  [[ $d == home || " ${LAYER_GROUPS[*]} " == *" $d "* ]] || fail "$U/$d is left from the flat layout"
done
found="$(find "$U" -name '*.old' -o -name '*.old.[0-9]*')"
[[ -z $found ]] || fail "files kept twice where one was untouched: $found"
for group in "" "${LAYER_GROUPS[@]}"; do
  [[ "$(readlink "$U/$group${group:+/}README.md")" == "$SKEL/$group${group:+/}README.md" ]] ||
    fail "$U/$group${group:+/}README.md isn't the map from the release"
done
step_done "every folder is back in its group, the maps beside them"

out="$(tmux -L user-layer-check -f "$C/tmux/tmux.conf" new-session -d -s t &&
  tmux -L user-layer-check show -gv @kubaos_probe; tmux -L user-layer-check show -gv @user_probe
  tmux -L user-layer-check kill-server)" || true
[[ $out == $'new\nmine' ]] || fail "tmux: want new/mine, got: $out"
out="$(git config --get kubaos.defaultprobe; git config --get kubaos.userprobe)" || true
[[ $out == $'new\nmine' ]] || fail "git config: want new/mine, got: $out"
(cd "$REPO" && git check-ignore -q a.kubaosprobe && git check-ignore -q a.userprobe) ||
  fail "git ignore: ours and the user's should both apply"
[[ "$(grep -c -e '^--wrap=never' -e '^--tabs=7' "$C/bat/config")" == 2 ]] || fail "bat config lacks ours or the user's"
bat --list-themes >/dev/null || fail "bat doesn't take its config"
out="$(ghostty +show-config 2>/dev/null | grep -e '^font-size' -e '^cursor-style = ' || true)"
[[ $out == *'font-size = 17'* && $out == *'cursor-style = underline'* ]] || fail "ghostty: want ours and the user's, got: $out"
foot --check-config >/dev/null 2>&1 || fail "foot --check-config"
fuzzel --check-config >/dev/null 2>&1 || fail "fuzzel --check-config"
# A marker line: on a fresh home, Neovim's first start also prints its plugin installs.
out="$(nvim --headless +'lua io.write("\nPROBE=", tostring(vim.g.kubaos_probe), " ", tostring(vim.g.user_probe), "\n")' +qa 2>&1 |
  tr -d '\r' | sed -n 's/^PROBE=//p')"
[[ $out == 'new mine' ]] || fail "nvim options: want new/mine, got: $out"
out="$(zsh -l -i -c 'userprobe; print -r -- "$LG_CONFIG_FILE|$BACON_PREFS"' 2>/dev/null | tr -d '\r')"
[[ $out == mine$'\n'*",$U/tools/lazygit/config.yml|$U/tools/bacon/prefs.toml" ]] || fail "zsh/lazygit/bacon: $out"
out="$(fastfetch --pipe -s title:os 2>&1)" || true
[[ $out == *' => '* ]] || fail "fastfetch didn't take the user's separator: $out"
[[ "$(readlink -f "$C/yazi/yazi.toml")" == "$U/tools/yazi/yazi.toml" ]] || fail "$C/yazi/yazi.toml isn't the user's"
grep -qx 'update_ms = 1717' "$C/btop/btop.conf" || fail "btop lost the user's value"
[[ "$(readlink -f "$C/kotodama/user.toml")" == "$U/menu/kotodama/user.toml" ]] || fail "$C/kotodama/user.toml isn't the user's"
out="$(kotodama config 2>&1)" || true
grep -qE '^skin_tone = "medium"  # .*/kotodama/kubaos\.toml$' <<<"$out" ||
  fail "kotodama config lacks the new default skin_tone: $(grep -m1 skin_tone <<<"$out")"
grep -qE '^nvim = "Mine"  # .*/kotodama/user\.toml$' <<<"$out" ||
  fail "kotodama config: the user's name for nvim doesn't win: $(grep -m1 '^nvim = ' <<<"$out")"
step_done "new defaults live, the user's values win"

out="$(kubaos-clock state 2>&1)" || true
[[ $out == *'"analog":true'* ]] || fail "the clock didn't read the user's analog = true: $out"
out="$(kubaos-sysmon settings 2>&1)" || true
[[ $out == *'"style":"bars"'* ]] || fail "the system monitor didn't read the user's style: $out"
out="$(kubaos cursor show 2>&1)" || true
[[ $out == *'size=32'* ]] || fail "the cursor didn't read the user's size: $out"
out="$(kubaos-idle status 2>&1)" || true
[[ $out == *'Lock after 2 min idle on battery, 5 min plugged in'* ]] || fail "kubaos-idle didn't read the user's lock: $out"
grep -qx '    timeout = 120' "$HOME/.local/state/kubaos/idle/hypridle.conf" ||
  fail "the switch didn't write hypridle's listeners from the user's idle.toml"
step_done "the clock, the system monitor, the cursor and idle read the user's files from their groups"

# 5. The update's migration runs after the switch, and the next update's
# switch runs dot-config again: neither changes a thing.
tree() { (cd "$U" && find . -path ./home -prune -o \( -type f -o -type l \) -print0 | sort -z | xargs -0 sha256sum); }
before="$(tree)"
out="$(KUBAOS_DIR="$REPO" bash -euo pipefail "$REPO/migrations/user/1792919877-grouped-user-layer.sh" 2>&1 &&
  "$REPO/scripts/dot-config" apply 2>&1)" || fail "the migration or dot-config apply: $out"
[[ -z $out ]] || fail "a second run said something, as if it moved a file: $out"
after="$(tree)"
if [[ $before != "$after" ]]; then
  diff <(printf '%s\n' "$before") <(printf '%s\n' "$after") || true
  fail "the migration or the second apply changed the user layer"
fi
step_done "the migration and a second apply change nothing"
