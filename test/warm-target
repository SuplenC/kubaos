#!/usr/bin/env bash
# test/warm-target: start a git worktree's cargo build from the main checkout's
# target/, so its first `cargo nextest` rebuilds only what differs from main.
# See docs/TESTING.md, "Warm worktree builds".
#
#   test/warm-target [WORKTREE]   warm WORKTREE (default: the worktree holding
#                                 the current directory)
#
# It reflink-copies the main checkout's target/ into the worktree (free on
# btrfs until a file changes), then gives every tracked file whose content is
# the main checkout's the main checkout's mtime: cargo's fingerprints are
# relative to the workspace and survive the move, but it judges a path
# dependency's sources by mtime, and a fresh checkout's are all newer than the
# copied build. A file that differs keeps its new mtime and is rebuilt, and
# so is every unit that read the main checkout by its absolute path.
#
# It never writes to the main checkout, and it never fails a worktree: where it
# can't copy (no reflinks on this filesystem, a cargo build holding main's
# target/ past WARM_TARGET_LOCK_WAIT seconds, default 60), or where the
# worktree has a target/ already, it changes nothing and cargo builds cold.
# Only a WORKTREE outside git is an error.
set -euo pipefail

LOCK_WAIT="${WARM_TARGET_LOCK_WAIT:-60}"

die() { printf 'warm-target: %s\n' "$*" >&2; exit 1; }
say() { printf 'warm-target: %s\n' "$*"; }

usage() {
  sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0"
}

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
  -*) usage >&2; exit 2 ;;
esac
(($# <= 1)) || { usage >&2; exit 2; }

wt="$(git -C "${1:-.}" rev-parse --show-toplevel 2>/dev/null)" || die "${1:-.} isn't in a git checkout"
common="$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir)"
main="${common%/.git}"

if [[ $main == "$common" ]]; then
  say "$wt has no main checkout to warm from (its git directory is $common); cargo builds cold"
  exit 0
fi
if [[ -n ${CARGO_TARGET_DIR:-} ]]; then
  say "CARGO_TARGET_DIR is $CARGO_TARGET_DIR, which every checkout shares: nothing to copy"
  exit 0
fi
if [[ $wt == "$main" ]]; then
  say "$wt is the main checkout, whose target/ is the one the worktrees copy"
  exit 0
fi
if [[ -e $wt/target ]]; then
  say "$wt/target is there already; leaving it"
  exit 0
fi
if [[ ! -d $main/target ]]; then
  say "$main has no target/ yet; cargo builds cold"
  exit 0
fi

# Holds every cargo lock in main's target/ for the copy: a build writing there
# meanwhile would leave a half-written artifact beside the fingerprint cargo
# trusts. The files are opened read-only, so main's target/ is never written.
lock_main_target() {
  local f fd
  for f in "$main"/target/*/.cargo-lock "$main"/target/*/.cargo-build-lock "$main"/target/*/.cargo-artifact-lock; do
    [[ -f $f ]] || continue
    exec {fd}<"$f"
    flock -x -w "$LOCK_WAIT" "$fd" || return 1
  done
}

# Copies main's target/ into the worktree as reflinks, through a temporary name
# so a failed copy leaves no target/ that cargo would take for a build.
copy_target() {
  local tmp="$wt/.target.warm-$$"
  if ! cp -a --reflink=always "$main/target" "$tmp" 2>/dev/null; then
    rm -rf "$tmp"
    return 1
  fi
  mv "$tmp" "$wt/target"
}

# Deletes the fingerprint of every copied unit whose build read the main
# checkout by its absolute path outside target/: a file included from outside
# its package (`include_str!("../../../install/…")`), or CARGO_MANIFEST_DIR
# baked into a test by `env!`. Cargo keeps those paths absolute, so the copy
# would judge the unit by main's files and run it against them; without a
# fingerprint it is rebuilt here, with the worktree's. rustc's dep-info,
# deps/<crate>-<hash>.d, names the paths and its unit's .fingerprint/*-<hash>.
# Prints the count.
forget_units_reading_main() {
  local f hash n=0
  while IFS= read -r f; do
    hash="${f##*-}"
    hash="${hash%.d}"
    rm -rf "$wt"/target/*/.fingerprint/*-"$hash" "$wt"/target/*/*/.fingerprint/*-"$hash"
    n=$((n + 1))
  done < <(find "$wt/target" -path '*/deps/*.d' -exec awk -v main="$main/" -v target="$main/target/" '
    {
      for (i = 1; i <= NF; i++) {
        p = $i
        sub(/^env-dep:[^=]*=/, "", p)
        if (index(p, main) == 1 && index(p, target) != 1) { print FILENAME; nextfile }
      }
    }' {} +)
  printf '%s\n' "$n"
}

# Gives each tracked file that is byte for byte the main checkout's the main
# checkout's mtime, so cargo judges it as it would in main. Prints the count.
mirror_mtimes() {
  local f n=0
  while IFS= read -r -d '' f; do
    [[ -f $wt/$f && ! -L $wt/$f && -f $main/$f && ! -L $main/$f ]] || continue
    cmp -s "$wt/$f" "$main/$f" || continue
    touch -r "$main/$f" "$wt/$f"
    n=$((n + 1))
  done < <(git -C "$wt" ls-files -z)
  printf '%s\n' "$n"
}

start=$SECONDS
if ! (lock_main_target && copy_target); then
  say "couldn't copy $main/target (no reflinks on this filesystem, or a cargo build held it ${LOCK_WAIT}s); cargo builds cold"
  exit 0
fi
forgotten="$(forget_units_reading_main)"
same="$(mirror_mtimes)"
say "$wt/target is $main/target's, reflinked; $same files match main's and $forgotten units read main's own files, so cargo rebuilds those units and what differs ($((SECONDS - start))s)"
