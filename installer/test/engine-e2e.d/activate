#!/bin/sh
# Fake home-manager activation: checks it runs the way the engine promises.
set -eu
echo "Starting Home Manager activation"
[ "$(id -u)" = 1000 ] || { echo "uid is $(id -u), not 1000" >&2; exit 1; }
[ "$(id -un)" = "$USER" ] || { echo "USER=$USER but id says $(id -un)" >&2; exit 1; }
[ "$PWD" = "$HOME" ] || { echo "cwd $PWD is not $HOME" >&2; exit 1; }
[ "$NIX_REMOTE" = daemon ] || { echo "NIX_REMOTE=$NIX_REMOTE" >&2; exit 1; }
[ -S /nix/var/nix/daemon-socket/socket ] || { echo "no nix-daemon socket" >&2; exit 1; }
[ -d "$HOME/Projects/dotfiles" ] || { echo "no ~/Projects/dotfiles" >&2; exit 1; }
printf 'user=%s uid=%s groups=%s home=%s nix_remote=%s backup=%s\n' \
  "$USER" "$(id -u)" "$(id -Gn | tr ' ' ,)" "$HOME" "$NIX_REMOTE" "$HOME_MANAGER_BACKUP_EXT" \
  > "$HOME/.hm-activated"
echo "Activation finished"
