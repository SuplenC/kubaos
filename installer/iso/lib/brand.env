KUBAOS_VERSION_SHORT=0.1
KUBAOS_RELEASE=Shinjuku
KUBAOS_RELEASE_ID=shinjuku
KUBAOS_VOLID=KUBAOS_0_1
KUBAOS_HOSTNAME=kubaos-live
