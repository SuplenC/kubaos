<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  The keyboard layouts in /etc/default/keyboard: what `pkexec` asks before it runs
  /usr/local/libexec/kubaos-keyboard-write (system/files/keyboard/) for
  `kubaos keyboard`. An admin at the machine needs no password
  (50-kubaos-keyboard.rules); anyone else is asked for an admin's.
  Installed in /usr/share/polkit-1/actions/ by system/50-hyprland.sh.
-->
<policyconfig>
  <vendor>KubaOS</vendor>
  <action id="org.kubaos.keyboard.set">
    <description>Change the keyboard layouts</description>
    <message>Authentication is required to change the keyboard layouts.</message>
    <icon_name>input-keyboard</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/kubaos-keyboard-write</annotate>
  </action>
</policyconfig>
