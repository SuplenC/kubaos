// Lets an admin at the machine change the keyboard layouts without a password:
// `kubaos keyboard` does, through localectl, from the control center's
// Keyboard tab and the Command menu. Those run without a terminal, so the only
// prompt polkit could show is the session agent's, and with no agent
// registered for the caller's session localed answers "Access denied" with no
// prompt at all. The action only covers the X11 and console keymaps localed
// writes to /etc/default/keyboard, not the locale or anything else.
// Installed as /etc/polkit-1/rules.d/50-kubaos-keyboard.rules by
// system/50-hyprland.sh.
// https://www.freedesktop.org/software/systemd/man/latest/org.freedesktop.locale1.html#Security
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.locale1.set-keyboard" &&
      subject.local && subject.active &&
      (subject.isInGroup("sudo") || subject.isInGroup("admin"))) {
    return polkit.Result.YES;
  }
});
