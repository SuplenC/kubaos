#!/usr/bin/env bash
# kubaos-apps: installs and removes apps of KubaOS's catalog, as root.
#
#   kubaos-apps install ID...
#   kubaos-apps remove ID...
#   kubaos-apps --help
#
# It takes only app ids, and reads each app's manifest from the root-owned catalog KubaOS
# ships, /usr/share/kubaos/apps/ID.toml (docs/CONTRACTS.md, "The Apps catalog"): never a
# package name, a URL or a path from its caller. An app from apt has its vendor repository set
# up first, by system/apt-repo.sh from the same checkout, its key checked against the package
# manifest's fingerprint; an app from a .deb is downloaded over https and installed only when
# its sha256 is the manifest's. An app from nixpkgs is the user's home's, never root's, and is
# refused. Every id is checked before anything changes, so one bad id changes nothing.
#
# install leaves an app that is there alone: a .deb at its pinned version, or one that updates
# itself at any version. An apt app for another architecture is refused. remove takes the apps'
# packages away with apt, keeping their configuration, and leaves the vendor repository in place.
# An app whose manifest names a setup gets install_<setup> from system/lib.sh after the install
# and remove_<setup> before the removal, for the user who asked: what it needs beyond its
# packages, such as a group or a systemd unit.
#
# `kubaos app add|remove` run it through pkexec (polkit action org.kubaos.apps,
# system/files/polkit/), one prompt per run; kubaos update runs it through sudo. Installed as
# /usr/local/libexec/kubaos-apps by install_apps_helper (system/lib.sh), root-owned.
#
# Exit codes: 0 done, 1 a step failed, 2 a usage error or an id it refuses (nothing changed).
set -euo pipefail

# KUBAOS_APPS_CHECKOUT points the catalog and the scripts at another checkout, for the tests
# (crates/kubaos-core/tests/apps_helper.rs), which run it as themselves. Root never reads it:
# pkexec clears the environment and sudo resets it, and a run as root ignores it all the same.
if ((EUID == 0)); then
  CHECKOUT=/usr/share/kubaos
  export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  unset APT_MANIFEST APT_CHOICES APT_RECORD
elif [[ -n ${KUBAOS_APPS_CHECKOUT:-} ]]; then
  CHECKOUT="$KUBAOS_APPS_CHECKOUT"
else
  printf 'kubaos-apps: this runs as root, through pkexec or sudo\n' >&2
  exit 1
fi
export KUBAOS_DIR="$CHECKOUT" LANG=C.UTF-8 DEBIAN_FRONTEND=noninteractive
umask 022
CATALOG="$CHECKOUT/apps"
SYSTEM="$CHECKOUT/system"

usage() {
  sed -n '2,6p' "$0" | cut -c3-
}

refuse() {
  printf 'kubaos-apps: %s\n' "$*" >&2
  exit 2
}

fail() {
  printf 'kubaos-apps: %s\n' "$*" >&2
  exit 1
}

# root_only FILE: owned by whoever runs this, root but for the tests' own checkout, and nobody
# else may write it or its folder. The tests hold their checkout to the same rule, so a check
# that stopped refusing fails them.
root_only() {
  local f owner mode
  for f in "$1" "$(dirname "$1")"; do
    [[ -e $f ]] || fail "$f is missing"
    read -r owner mode < <(stat -L -c '%u %a' "$f")
    [[ $owner == "$EUID" ]] || fail "$f isn't owned by uid $EUID; refusing to run it"
    (((8#$mode & 8#022) == 0)) || fail "$f is writable by others; refusing to run it"
  done
}

verb="${1:-}"
case "$verb" in
  install | remove) shift ;;
  -h | --help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac
(($#)) || { usage >&2; exit 2; }
ids=()
for id in "$@"; do
  [[ $id =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || refuse "$id is not an app id"
  [[ -f "$CATALOG/$id.toml" ]] || refuse "the catalog has no app $id"
  ids+=("$id")
done

for f in "$SYSTEM/lib.sh" "$SYSTEM/manifest.sh" "$SYSTEM/apt-repo.sh" "$SYSTEM/packages.toml"; do
  root_only "$f"
done
# shellcheck source=system/lib.sh
source "$SYSTEM/lib.sh"
# The user who asked, whom an app's setup is for: pkexec names them by uid, and lib.sh takes
# sudo's SUDO_USER, both set by the program that gave root, never by the caller.
if ((EUID == 0)) && [[ ${PKEXEC_UID:-} =~ ^[0-9]+$ ]]; then
  TARGET_USER="$(id -nu "$PKEXEC_UID")"
fi

# app_value ID TABLE KEY: the values of KEY in the app's [TABLE] ("" for the top), one a line.
app_value() {
  manifest_dump "$CATALOG/$1.toml" | awk -F'\t' -v t="$2" -v k="$3" '$1 == t && $2 == k { print $3 }'
}

# source_of ID: apt, nix or deb, the one source table the manifest has.
source_of() {
  manifest_dump "$CATALOG/$1.toml" | awk -F'\t' '$1 == "apt" || $1 == "nix" || $1 == "deb" { print $1; exit }'
}

declare -A kind setup
for id in "${ids[@]}"; do
  root_only "$CATALOG/$id.toml"
  kind[$id]="$(source_of "$id")"
  case "${kind[$id]}" in
    apt)
      # A repo is a name of the package manifest, held to an id's pattern so it is never an
      # option to apt-repo.sh.
      while read -r repo; do
        [[ $repo =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || refuse "$id names $repo, which is not a repository name"
      done < <(app_value "$id" apt repo)
      ;;
    deb) ;;
    nix) refuse "$id comes from nixpkgs, into your home: kubaos app installs it without root" ;;
    *) refuse "$id has no source the helper knows" ;;
  esac
  only="$(app_value "$id" apt arch)"
  if [[ $verb == install && -n $only && $only != "$(arch)" ]]; then
    refuse "$id is for $only only, and this machine is $(arch)"
  fi
  setup[$id]="$(app_value "$id" "" setup)"
  if [[ -n ${setup[$id]} ]]; then
    [[ ${setup[$id]} =~ ^[a-z][a-z0-9_]{0,63}$ ]] || refuse "$id names a setup that isn't one: ${setup[$id]}"
    for f in "install_${setup[$id]}" "remove_${setup[$id]}"; do
      [[ $(type -t "$f") == function ]] || refuse "$id's setup needs $f, which system/lib.sh doesn't define"
    done
  fi
done

# install_deb ID: the app's .deb for this architecture, unless it is there at its pin, or at
# all when it updates itself.
install_deb() {
  local id="$1" package version url sha current dir
  package="$(app_value "$id" deb package)"
  version="$(app_value "$id" deb version)"
  url="$(app_value "$id" "deb.$(arch)" url)"
  sha="$(app_value "$id" "deb.$(arch)" sha256)"
  [[ $url == https://* && $sha =~ ^[0-9a-f]{64}$ ]] || die "$id has no download for $(arch)"
  if pkg_installed "$package"; then
    current="$(dpkg-query -W -f='${Version}' "$package")"
    if [[ $current == "$version" || "$(app_value "$id" deb self_updates)" == true ]]; then
      ok "$id: $package $current is installed"
      return 0
    fi
  fi
  dir="$(mktemp -d)"
  # apt reads a local .deb as its own _apt user.
  chmod 0755 "$dir"
  run curl -fsSL --proto '=https' --tlsv1.2 --retry 2 -o "$dir/$package.deb" "$url" ||
    { rm -rf "$dir"; die "$id: downloading $url failed"; }
  if ! sha256sum --quiet -c - <<<"$sha  $dir/$package.deb" >/dev/null 2>&1; then
    rm -rf "$dir"
    die "$id: $url is not the download its manifest pins (sha256 $sha); nothing installed"
  fi
  chmod 0644 "$dir/$package.deb" 2>/dev/null || true
  sudo_run apt-get install -y --no-install-recommends -o Dpkg::Options::=--force-confdef \
    -o Dpkg::Options::=--force-confold "$dir/$package.deb" || { rm -rf "$dir"; die "$id: installing $package failed"; }
  rm -rf "$dir"
}

install_apps() {
  local id repos=() packages=()
  for id in "${ids[@]}"; do
    [[ ${kind[$id]} == apt ]] || continue
    mapfile -t -O "${#repos[@]}" repos < <(app_value "$id" apt repo)
    mapfile -t -O "${#packages[@]}" packages < <(app_value "$id" apt packages)
  done
  if ((${#repos[@]})); then
    mapfile -t repos < <(printf '%s\n' "${repos[@]}" | awk '!seen[$0]++')
    run "$SYSTEM/apt-repo.sh" "${repos[@]}"
  fi
  if ((${#packages[@]})); then
    mapfile -t packages < <(printf '%s\n' "${packages[@]}" | awk '!seen[$0]++')
    apt_install "${packages[@]}"
  fi
  for id in "${ids[@]}"; do
    [[ ${kind[$id]} == deb ]] && install_deb "$id"
  done
  for id in "${ids[@]}"; do
    [[ -z ${setup[$id]} ]] || "install_${setup[$id]}"
  done
  ok "installed ${ids[*]}"
}

remove_apps() {
  local id p remove=()
  for id in "${ids[@]}"; do
    [[ -z ${setup[$id]} ]] || "remove_${setup[$id]}"
    case "${kind[$id]}" in
      apt) mapfile -t -O "${#remove[@]}" remove < <(app_value "$id" apt packages) ;;
      deb) remove+=("$(app_value "$id" deb package)") ;;
    esac
  done
  local installed=()
  for p in "${remove[@]}"; do
    pkg_installed "$p" && installed+=("$p")
  done
  if ((${#installed[@]} == 0)); then
    ok "${ids[*]}: not installed"
    return 0
  fi
  sudo_run apt-get remove -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
    "${installed[@]}"
  ok "removed ${ids[*]}"
}

"${verb}_apps"
