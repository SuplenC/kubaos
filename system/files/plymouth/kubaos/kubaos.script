# KubaOS boot splash (Plymouth script module).
#
# The KubaOS neon sign in the middle of the dark. It switches on once, a group
# of tubes at a time (ク, バ, the dakuten, Kuba, OS), each stuttering before it
# catches, then hums for as long as the boot takes, with a blink on バ every
# few seconds. When the initramfs asks for the disk passphrase, the field fades
# in under it: docs/DESIGN.md's `Field`, as the lock screen draws its password
# field, with the focus ring, a caret and a note under it. A wrong passphrase
# shakes the field as the lock screen does and says so in the note.
#
# On shutdown and reboot (plymouth-poweroff and plymouth-reboot start it in
# those modes) the same sign plays backwards: lit, then OS, Kuba, the dakuten,
# バ and ク sputter out, and the dead glass fades into black, in under two
# seconds. kubaos-shutdown-splash.service holds the final poweroff until 2 s
# after the splash shows, so keep the whole of it, DARK_AT plus the fade,
# under that.
#
# Installed to /usr/share/plymouth/themes/kubaos by system/25-boot.sh. The
# sign's layers come from branding/neon.py, every other picture from
# branding/boot.py, both drawn from the design tokens; the values this script
# reads are in the generated block below. The only text drawn here is what
# other programs send (fsck, a missing disk): label-freetype draws it with
# /usr/share/fonts/Plymouth.ttf (Geist), which the initramfs hook provides.
#
# HiDPI: plymouthd.conf sets DeviceScale=1, so this script works in device
# pixels and picks the @2x pictures itself on screens
# `tokens.boot.plymouth_2x_from` px tall or more (the laptop's 2880x1800).
# Plymouth's own 2x scaling would upscale the 1x PNGs and blur them.
#
# The cryptsetup initramfs script talks to us through plymouth:
#   ask-for-password  "Please unlock disk cryptroot: "   -> the field
#   message           "cryptsetup: ERROR: cryptroot: cryptsetup failed, bad password or options?"
#   message           "cryptsetup: cryptroot: set up successfully"

# --- tokens: @generated by `kubaos-tokens` from `design/tokens.toml` ----------
# Every `tokens.` value this script reads: colours from the dark palette, as red, green
# and blue from 0 to 1; lengths in logical pixels; durations in milliseconds. Change them
# in design/tokens.toml and run `cargo run -p kubaos-tokens -- write`.
tokens.boot.plymouth_2x_from = 1600;
tokens.color.on_surface_variant.r = 0.8549;
tokens.color.on_surface_variant.g = 0.7608;
tokens.color.on_surface_variant.b = 0.6941;
tokens.color.surface_container_lowest.r = 0.0784;
tokens.color.surface_container_lowest.g = 0.0510;
tokens.color.surface_container_lowest.b = 0.0275;
tokens.duration.medium = 300;
tokens.duration.micro = 100;
tokens.duration.short = 200;
tokens.easing.emphasized_accel[0] = 0.3;
tokens.easing.emphasized_accel[1] = 0.0;
tokens.easing.emphasized_accel[2] = 0.8;
tokens.easing.emphasized_accel[3] = 0.15;
tokens.easing.standard[0] = 0.2;
tokens.easing.standard[1] = 0.0;
tokens.easing.standard[2] = 0.0;
tokens.easing.standard[3] = 1.0;
tokens.easing.standard_accel[0] = 0.3;
tokens.easing.standard_accel[1] = 0.0;
tokens.easing.standard_accel[2] = 1.0;
tokens.easing.standard_accel[3] = 1.0;
tokens.easing.standard_decel[0] = 0.0;
tokens.easing.standard_decel[1] = 0.0;
tokens.easing.standard_decel[2] = 0.0;
tokens.easing.standard_decel[3] = 1.0;
tokens.focus.offset = 4;
tokens.neon.strike[0] = 0.6;
tokens.neon.strike[1] = 0.0;
tokens.neon.strike[2] = 0.9;
tokens.neon.strike[3] = 0.2;
tokens.neon.strike[4] = 0.0;
tokens.neon.strike[5] = 1.0;
tokens.neon.strike[6] = 0.4;
tokens.neon.strike[7] = 1.0;
tokens.neon.strike[8] = 0.8;
tokens.neon.strike[9] = 1.0;
tokens.neon.strike.count = 10;
tokens.size.control_md = 40;
tokens.size.keycap = 20;
tokens.size.password = 320;
tokens.space.s12 = 12;
tokens.space.s4 = 4;
tokens.space.s48 = 48;
tokens.space.s8 = 8;
tokens.type.body_large.icon = 20;
tokens.type.small.line = 16;
tokens.type.small.size = 12;
# --- end of tokens ------------------------------------------------------------

# Every frame of the display's refresh: a sprite redraws only when it changes,
# so a still splash costs nothing between the hum's steps.
FPS = 60;
Plymouth.SetRefreshRate(FPS);

# --- the sign ------------------------------------------------------------------
# The tube groups in switch-on order, each a layer over the dead glass
# (sign-base), and when each strikes, in ms: the cues of the switch-on.
GROUP[0] = "ku";      STRIKE_AT[0] = 200;
GROUP[1] = "ba";      STRIKE_AT[1] = 533;
GROUP[2] = "dakuten"; STRIKE_AT[2] = 1000;
GROUP[3] = "kuba";    STRIKE_AT[3] = 1333;
GROUP[4] = "os";      STRIKE_AT[4] = 1800;
GROUPS = 5;
# Everything is on once the last group has struck.
SETTLED = STRIKE_AT[GROUPS - 1] + tokens.duration.medium;
# The hum: a 3% flicker that steps to a new level this often, a slow texture
# rather than a move. Every HUM_LOOP ms, バ blinks BLINK_AT ms into the loop,
# a step every BLINK_STEP ms.
HUM_STEP = 100;
HUM_LOOP = 4000;
BLINK_AT = 2000;
BLINK_STEP = 33;
BLINK[0] = 0.35; BLINK[1] = 1; BLINK[2] = 0.5; BLINK[3] = 1;
BLINK_STEPS = 4;
# Shutting down: the lit sign holds, then a group goes out every OFF_STEP ms,
# the last first, each with the strike played backwards. Once ク is dark the
# glass and the background fade to black, leaving over `medium`.
OFF_HOLD = 200;
OFF_STEP = 200;
for (i = 0; i < GROUPS; i++)
  OFF_AT[i] = OFF_HOLD + (GROUPS - 1 - i) * OFF_STEP;
DARK_AT = OFF_AT[0] + tokens.duration.medium;

# --- the prompt ------------------------------------------------------------------
# The caret's blink, `kubaos_ui::component::field::BLINK`: solid for one after
# it moves, so it never hides while you type. Behaviour, not motion.
CARET_BLINK = 530;
# The shake that answers a wrong passphrase, as the lock screen's: three jolts
# over `micro`, then back to rest over `short`.
SHAKE_TO[0] = tokens.space.s12;  SHAKE_MS[0] = tokens.duration.micro;  SHAKE_CURVE[0] = tokens.easing.standard;
SHAKE_TO[1] = -tokens.space.s8;  SHAKE_MS[1] = tokens.duration.micro;  SHAKE_CURVE[1] = tokens.easing.standard;
SHAKE_TO[2] = tokens.space.s4;   SHAKE_MS[2] = tokens.duration.micro;  SHAKE_CURVE[2] = tokens.easing.standard;
SHAKE_TO[3] = 0;                 SHAKE_MS[3] = tokens.duration.short;  SHAKE_CURVE[3] = tokens.easing.standard_decel;
SHAKES = 4;

# --- state -------------------------------------------------------------------
mode = Plymouth.GetMode();
shutting_down = (mode == "shutdown" || mode == "reboot");
frame = 0;
now = 0;                # ms since the splash started
scale = 0;              # 1 or 2, set by layout()
prompt = "none";        # none | password | busy
bullets = 0;
wrong = 0;              # a wrong passphrase was reported and not typed over yet
caret_moved = 0;
shake_start = -100000;
# The prompt's opacity eases from fade_from to fade_to over fade_ms, on
# fade_curve, from fade_start.
fade_from = 0;
fade_to = 0;
fade_start = 0;
fade_ms = 1;
fade_curve = tokens.easing.standard;
prompt_alpha = 0;
hum = 1;
hum_step = -1;
message_text = "";

fun contains(haystack, needle)
{
  n = needle.Length();
  h = haystack.Length();
  for (i = 0; i + n <= h; i++)
    {
      if (haystack.SubString(i, i + n) == needle)
        return 1;
    }
  return 0;
}

# One coordinate of a cubic Bézier from 0 to 1 through control points a and b.
fun cubic(a, b, t)
{
  u = 1 - t;
  return 3 * u * u * t * a + 3 * u * t * t * b + t * t * t;
}

# `curve` (x1, y1, x2, y2), a CSS cubic Bézier, at progress x from 0 to 1.
fun ease(curve, x)
{
  if (x <= 0)
    return 0;
  if (x >= 1)
    return 1;
  lo = 0;
  hi = 1;
  for (i = 0; i < 16; i++)
    {
      t = (lo + hi) / 2;
      if (cubic(curve[0], curve[2], t) < x)
        lo = t;
      else
        hi = t;
    }
  return cubic(curve[1], curve[3], (lo + hi) / 2);
}

fun asset(name)
{
  if (global.scale == 2)
    return Image(name + "@2x.png");
  return Image(name + ".png");
}

fun place(sprite, image, x, y)
{
  sprite.SetImage(image);
  sprite.SetX(x);
  sprite.SetY(y);
}

# A message another program sent, in the `small` style.
fun message_image(str)
{
  c = tokens.color.on_surface_variant;
  return Image.Text(str, c.r, c.g, c.b, 1, "Geist " + tokens.type.small.size * global.scale + "px");
}

# --- layout --------------------------------------------------------------------
fun load_assets()
{
  global.img_base = asset("sign-base");
  global.img_lit = asset("sign-lit");
  for (i = 0; i < GROUPS; i++)
    global.img_group[i] = asset("sign-" + GROUP[i]);
  global.img_field = asset("field");
  global.img_field_error = asset("field-error");
  global.img_field_busy = asset("field-busy");
  global.img_icon_lock = asset("icon-lock");
  global.img_icon_busy = asset("icon-busy");
  global.img_bullet = asset("bullet");
  global.img_bullet_busy = asset("bullet-busy");
  global.img_caret = asset("caret");
  global.img_placeholder = asset("placeholder");
  global.img_note["hint"] = asset("note-hint");
  global.img_note["caps"] = asset("note-caps");
  global.img_note["wrong"] = asset("note-wrong");
  global.img_note_busy = asset("note-busy");
  if (global.message_text != "")
    global.img_message = message_image(global.message_text);
}

fun make_sprites()
{
  global.spr_base = Sprite();
  global.spr_base.SetZ(1);
  for (i = 0; i < GROUPS; i++)
    {
      global.spr_group[i] = Sprite();
      global.spr_group[i].SetZ(2 + i);
      global.spr_group[i].SetOpacity(0);
    }
  global.spr_lit = Sprite();
  global.spr_lit.SetZ(2 + GROUPS);
  global.spr_lit.SetOpacity(0);
  global.spr_field = Sprite();
  global.spr_field.SetZ(10);
  global.spr_icon = Sprite();
  global.spr_placeholder = Sprite();
  global.spr_caret = Sprite();
  global.spr_note = Sprite();
  global.spr_icon.SetZ(11);
  global.spr_placeholder.SetZ(11);
  global.spr_caret.SetZ(12);
  global.spr_note.SetZ(11);
  global.spr_message = Sprite();
  global.spr_message.SetZ(11);
  global.spr_message.SetOpacity(0);
  set_prompt_opacity(0);
}

# A column centred on the screen: the sign, then the field right under it
# (the sign's glow is its own clear space), then the note `space.s8` below. The
# field's room is kept whether or not it shows, so it never moves the sign.
fun layout()
{
  W = Window.GetWidth();
  H = Window.GetHeight();
  s = 1;
  if (H >= tokens.boot.plymouth_2x_from)
    s = 2;
  if (s != global.scale)
    {
      global.scale = s;
      load_assets();
    }
  if (!global.spr_base)
    make_sprites();
  global.W = W;
  global.H = H;
  cx = Window.GetX() + Math.Int(W / 2);
  below = (tokens.size.control_md + tokens.space.s8 + tokens.size.keycap) * s;
  top = Window.GetY() + Math.Int((H - global.img_lit.GetHeight() - below) / 2);

  # Every layer of the sign has the same size, so they all share one place.
  sign_x = cx - Math.Int(global.img_lit.GetWidth() / 2);
  place(global.spr_base, global.img_base, sign_x, top);
  place(global.spr_lit, global.img_lit, sign_x, top);
  for (i = 0; i < GROUPS; i++)
    place(global.spr_group[i], global.img_group[i], sign_x, top);

  global.field_x = cx - Math.Int(tokens.size.password * s / 2);
  global.field_y = top + global.img_lit.GetHeight();
  # The text starts past the icon, `space.s12` in, then `space.s8` after it,
  # and keeps `space.s12` clear at the end, as `Field` lays it out.
  global.text_dx = (tokens.space.s12 + tokens.type.body_large.icon + tokens.space.s8) * s;
  global.text_dy = tokens.space.s8 * s;
  room = (tokens.size.password - tokens.space.s12) * s - global.text_dx;
  global.thin = global.img_caret.GetWidth();
  global.bullet_step = global.img_bullet.GetWidth();
  global.bullet_max = Math.Int((room - global.thin) / global.bullet_step);
  global.cx = cx;
  global.note_y = global.field_y + (tokens.size.control_md + tokens.space.s8) * s;
  global.message_y = Window.GetY() + H - (tokens.space.s48 + tokens.type.small.line) * s;
  place_message();
  update_prompt();
  place_field(0);
}

fun place_message()
{
  if (global.message_text == "")
    return;
  m = global.img_message;
  global.spr_message.SetImage(m);
  global.spr_message.SetX(global.cx - Math.Int(m.GetWidth() / 2));
  global.spr_message.SetY(global.message_y + Math.Int((tokens.type.small.line * global.scale - m.GetHeight()) / 2));
}

# --- the prompt ------------------------------------------------------------------
# The pictures for the prompt's state: the field, its icon and bullets, and
# the note under it.
fun update_prompt()
{
  busy = (global.prompt == "busy");
  if (busy)
    global.spr_field.SetImage(global.img_field_busy);
  else if (global.wrong)
    global.spr_field.SetImage(global.img_field_error);
  else
    global.spr_field.SetImage(global.img_field);
  if (busy)
    global.spr_icon.SetImage(global.img_icon_busy);
  else
    global.spr_icon.SetImage(global.img_icon_lock);
  global.spr_placeholder.SetImage(global.img_placeholder);
  global.spr_caret.SetImage(global.img_caret);

  if (busy)
    note = global.img_note_busy;
  else
    note = global.img_note[note_name()];
  global.note_shown = note_name();
  if (busy)
    global.note_shown = "busy";
  global.spr_note.SetImage(note);
  global.spr_note.SetX(global.cx - Math.Int(note.GetWidth() / 2));
  global.spr_note.SetY(global.note_y);

  bullet = global.img_bullet;
  if (busy)
    bullet = global.img_bullet_busy;
  for (i = 0; i < global.bullet_max; i++)
    {
      if (!global.spr_bullets[i])
        {
          global.spr_bullets[i] = Sprite();
          global.spr_bullets[i].SetZ(11);
          global.spr_bullets[i].SetOpacity(0);
        }
      global.spr_bullets[i].SetImage(bullet);
    }
  global.shown_bullets = Math.Min(global.bullets, global.bullet_max);
}

# The field and everything in it, `dx` off its place while it shakes.
fun place_field(dx)
{
  s = global.scale;
  x = global.field_x + dx;
  ring = tokens.focus.offset * s;
  global.spr_field.SetX(x - ring);
  global.spr_field.SetY(global.field_y - ring);
  icon_dy = Math.Int((tokens.size.control_md - tokens.type.body_large.icon) * s / 2);
  global.spr_icon.SetX(x + tokens.space.s12 * s);
  global.spr_icon.SetY(global.field_y + icon_dy);
  text_x = x + global.text_dx;
  text_y = global.field_y + global.text_dy;
  global.spr_placeholder.SetX(text_x);
  global.spr_placeholder.SetY(text_y);
  for (i = 0; i < global.bullet_max; i++)
    {
      global.spr_bullets[i].SetX(text_x + i * global.bullet_step);
      global.spr_bullets[i].SetY(text_y);
    }
  global.spr_caret.SetX(text_x + global.shown_bullets * global.bullet_step - Math.Int(global.thin / 2));
  global.spr_caret.SetY(text_y);
}

fun set_prompt_opacity(a)
{
  global.spr_field.SetOpacity(a);
  global.spr_icon.SetOpacity(a);
  global.spr_note.SetOpacity(a);
  for (i = 0; i < global.bullet_max; i++)
    {
      if (i < global.shown_bullets)
        global.spr_bullets[i].SetOpacity(a);
      else
        global.spr_bullets[i].SetOpacity(0);
    }
  if (global.shown_bullets == 0)
    global.spr_placeholder.SetOpacity(a);
  else
    global.spr_placeholder.SetOpacity(0);
  caret = 0;
  if (global.prompt == "password" && (global.now - global.caret_moved) % (2 * CARET_BLINK) < CARET_BLINK)
    caret = a;
  global.spr_caret.SetOpacity(caret);
}

# The prompt fades in over `short`, and out over `medium`, as a toast does.
fun fade(to)
{
  if (to == global.fade_to)
    return;
  global.fade_from = global.prompt_alpha;
  global.fade_to = to;
  global.fade_start = global.now;
  if (to > global.fade_from)
    {
      global.fade_ms = tokens.duration.short;
      global.fade_curve = tokens.easing.standard;
    }
  else
    {
      global.fade_ms = tokens.duration.medium;
      global.fade_curve = tokens.easing.standard_accel;
    }
}

# How far off its place the shaking field is, `ms` into the shake.
fun shake_offset(ms)
{
  from = 0;
  for (i = 0; i < SHAKES; i++)
    {
      if (ms < SHAKE_MS[i])
        return Math.Int(from + (SHAKE_TO[i] - from) * ease(SHAKE_CURVE[i], ms / SHAKE_MS[i]));
      ms -= SHAKE_MS[i];
      from = SHAKE_TO[i];
    }
  return 0;
}

# --- the sign's animation ------------------------------------------------------
# How bright group `g` is `t` ms in: off, striking, then on, apart from バ's
# blink in each hum loop.
fun level(g, t)
{
  if (global.shutting_down)
    return off_level(g, t);
  since = t - STRIKE_AT[g];
  if (since < 0)
    return 0;
  step = Math.Int(since * tokens.neon.strike.count / tokens.duration.medium);
  if (step < tokens.neon.strike.count)
    return tokens.neon.strike[step];
  if (t >= SETTLED && GROUP[g] == "ba")
    {
      blink = Math.Int(((t - SETTLED) % HUM_LOOP - BLINK_AT) / BLINK_STEP);
      if (blink >= 0 && blink < BLINK_STEPS)
        return BLINK[blink];
    }
  return 1;
}

# How bright group `g` is `t` ms into the way down: on, sputtering out, then
# off for good.
fun off_level(g, t)
{
  since = t - OFF_AT[g];
  if (since < 0)
    return 1;
  step = Math.Int(since * tokens.neon.strike.count / tokens.duration.medium);
  if (step < tokens.neon.strike.count)
    return tokens.neon.strike[tokens.neon.strike.count - 1 - step];
  return 0;
}

# How far the dead glass and the background have faded on the way down: 0
# until ク is out, 1 once the screen is black.
fun darkness(t)
{
  if (!global.shutting_down)
    return 0;
  return ease(tokens.easing.emphasized_accel, (t - DARK_AT) / tokens.duration.medium);
}

fun set_background(light)
{
  c = tokens.color.surface_container_lowest;
  Window.SetBackgroundTopColor(c.r * light, c.g * light, c.b * light);
  Window.SetBackgroundBottomColor(c.r * light, c.g * light, c.b * light);
  global.background_light = light;
}

# While any group is below full, the dead glass and every group draw as their
# own layers. Once all are on, the merged sign-lit draws instead, for the rest
# of the boot: one blend per pixel of the sign instead of six. It is the layers
# merged (branding/neon.py), so the swap doesn't show.
fun draw_sign(t)
{
  all_on = 1;
  for (i = 0; i < GROUPS; i++)
    {
      global.group_level[i] = level(i, t);
      if (global.group_level[i] < 1)
        all_on = 0;
    }
  if (all_on)
    {
      step = Math.Int(t / HUM_STEP);
      if (step != global.hum_step)
        {
          global.hum_step = step;
          global.hum = 0.97 + 0.03 * Math.Random();
        }
      global.spr_lit.SetOpacity(global.hum);
      global.spr_base.SetOpacity(0);
      for (i = 0; i < GROUPS; i++)
        global.spr_group[i].SetOpacity(0);
      return;
    }
  light = 1 - darkness(t);
  global.spr_lit.SetOpacity(0);
  global.spr_base.SetOpacity(light);
  # Setting the background redraws the whole screen, so only when it fades.
  if (global.shutting_down && light != global.background_light)
    set_background(light);
  for (i = 0; i < GROUPS; i++)
    global.spr_group[i].SetOpacity(global.group_level[i]);
}

fun refresh()
{
  global.frame++;
  global.now = Math.Int(global.frame * 1000 / FPS);
  if (Window.GetWidth() != global.W || Window.GetHeight() != global.H)
    layout();

  draw_sign(global.now);

  global.prompt_alpha = global.fade_from + (global.fade_to - global.fade_from)
    * ease(global.fade_curve, (global.now - global.fade_start) / global.fade_ms);

  place_field(shake_offset(global.now - global.shake_start));
  if (global.prompt == "password")
    update_note_only();
  set_prompt_opacity(global.prompt_alpha);
}

# The note while the field takes a passphrase: what went wrong beats Caps
# Lock beats the hint.
fun note_name()
{
  if (global.wrong)
    return "wrong";
  if (Plymouth.GetCapslockState())
    return "caps";
  return "hint";
}

# Caps Lock can change between keystrokes; only the note under the field cares.
fun update_note_only()
{
  if (note_name() != global.note_shown)
    update_prompt();
}

# --- plymouth callbacks -----------------------------------------------------------
fun on_password(prompt_text, count)
{
  # Typing again after a wrong passphrase clears the complaint.
  if (global.prompt == "password" && count > global.bullets)
    global.wrong = 0;
  global.prompt = "password";
  global.bullets = count;
  global.caret_moved = global.now;
  fade(1);
  update_prompt();
}

fun on_normal()
{
  # Enter was pressed (or the prompt went away): keep the field up, dimmed,
  # while cryptsetup works through argon2id. A message settles it.
  if (global.prompt == "password")
    {
      global.prompt = "busy";
      update_prompt();
    }
}

fun on_message(text)
{
  if (contains(text, "bad password"))
    {
      global.wrong = 1;
      global.bullets = 0;
      global.prompt = "password";
      global.caret_moved = global.now;
      global.shake_start = global.now;
      update_prompt();
      return;
    }
  if (contains(text, "set up successfully"))
    {
      global.wrong = 0;
      global.prompt = "none";
      fade(0);
      return;
    }
  # Anything else (fsck, a missing disk, ...): small, at the bottom.
  global.message_text = text;
  global.img_message = message_image(text);
  place_message();
  global.spr_message.SetOpacity(1);
}

fun on_hide_message(text)
{
  if (text == global.message_text)
    {
      global.message_text = "";
      global.spr_message.SetOpacity(0);
    }
}

fun on_quit()
{
  global.fade_to = 0;
  global.fade_from = 0;
  global.prompt_alpha = 0;
  set_prompt_opacity(0);
}

set_background(1);
layout();
Plymouth.SetRefreshFunction(refresh);
Plymouth.SetDisplayPasswordFunction(on_password);
Plymouth.SetDisplayNormalFunction(on_normal);
Plymouth.SetMessageFunction(on_message);
Plymouth.SetHideMessageFunction(on_hide_message);
Plymouth.SetDisplayHotplugFunction(layout);
Plymouth.SetQuitFunction(on_quit);
