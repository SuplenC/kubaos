# @generated by `kubaos-tokens` from `design/tokens.toml`. Change the tokens there and run
# `cargo run -p kubaos-tokens -- write`.
[Plymouth Theme]
Name=KubaOS
Description=The KubaOS neon sign switching on in the dark, with the disk passphrase prompt
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/kubaos
ScriptFile=/usr/share/plymouth/themes/kubaos/kubaos.script
# Console text (Esc, or a boot that falls back to details): a note on the splash's dark.
ConsoleLogTextColor=0xdac2b1
ConsoleLogBackgroundColor=0x140d07
