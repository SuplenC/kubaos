# Ghostty is a plain terminal here: tmux does panes/windows, Hyprland does
# window management. No splits or tabs.

# The font, its size, the padding, the glass and a fallback palette are the
# design tokens' (config/ghostty/tokens, loaded below). Sizes are in points,
# which Ghostty multiplies by each screen's scale, so the text keeps its size
# on any screen whose scale matches its density (Hyprland picks it,
# config/hypr/monitors.lua).
window-padding-balance = true
window-step-resize = false
window-padding-color = extend

# Translucent: Hyprland blurs and darkens what shows through
# (decoration:blur in config/hypr/looks.lua), so the wallpaper reads as a
# dim, frosted tint behind the text. Ghostty's own blur only works on KDE.
# Cells with an explicit background (Neovim floats, tmux pills, selections)
# stay opaque; Neovim and tmux leave the main background unpainted
# (config/nvim/lua/config/theme.lua, config/tmux/tmux.conf).
background-opacity-cells = false
background-blur = false

# Hyprland draws no title bar for us anyway; drop the GTK header bar.
window-decoration = none
# Windows come from one background instance (home/terminal.nix), which the
# binds reach with `ghostty +new-window`. A plain `ghostty` joins it too.
# `detect` gives a launch with arguments (`-e`, `--working-directory`) or
# from inside a terminal a process of its own, because a running instance
# would ignore those arguments.
gtk-single-instance = detect

# The tokens, then the wallpaper's palette from the theme pipeline (dot-theme,
# matugen), which overrides the tokens' fallback palette. Ghostty loads them
# after this file, in this order. `?` = optional.
config-file = tokens
config-file = ?~/.local/state/theme/ghostty
# dot-theme reloads every Ghostty window when the wallpaper changes; skip the
# "Reloaded the configuration" toast that would pop up in each of them.
app-notifications = no-config-reload

# --- Unbind tab/split/window defaults (tmux and Hyprland own these) ---
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+w=unbind
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind
keybind = ctrl+shift+enter=unbind
keybind = ctrl+shift+arrow_left=unbind
keybind = ctrl+shift+arrow_right=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+page_up=unbind
keybind = ctrl+page_down=unbind
keybind = ctrl+alt+arrow_up=unbind
keybind = ctrl+alt+arrow_down=unbind
keybind = ctrl+alt+arrow_left=unbind
keybind = ctrl+alt+arrow_right=unbind
keybind = super+ctrl+[=unbind
keybind = super+ctrl+]=unbind
keybind = super+ctrl+shift+arrow_up=unbind
keybind = super+ctrl+shift+arrow_down=unbind
keybind = super+ctrl+shift+arrow_left=unbind
keybind = super+ctrl+shift+arrow_right=unbind
keybind = alt+digit_1=unbind
keybind = alt+digit_2=unbind
keybind = alt+digit_3=unbind
keybind = alt+digit_4=unbind
keybind = alt+digit_5=unbind
keybind = alt+digit_6=unbind
keybind = alt+digit_7=unbind
keybind = alt+digit_8=unbind
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind

# Your settings, last so they win (~/.config/kubaos, docs/CONTRACTS.md).
config-file = ?~/.config/kubaos/terminal/ghostty/config
