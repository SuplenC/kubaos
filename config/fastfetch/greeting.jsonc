// The greeting a new Ghostty window shows (home/shell.nix): the クバ mark and
// a short list, so the prompt isn't kept waiting. Timed in the harness, the
// modules left out cost the most: gpu 154 ms, packages 25 ms, shell 17 ms,
// display 9 ms, wm 9 ms, theme 4 ms; each one here takes under 1 ms.
// `fastfetch` on its own still shows everything (config.jsonc). Merged like
// config.jsonc: the wallpaper theme's colours over this file, then your
// greeting.jsonc in ~/.config/kubaos/terminal/fastfetch.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/kubaos.txt",
    "padding": { "right": 2 }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "terminal",
    "cpu",
    "memory",
    "disk",
    "battery",
    "break",
    "colors"
  ]
}
