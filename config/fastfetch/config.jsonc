// fastfetch on KubaOS: the クバ mark from branding/fastfetch.txt
// (branding/README.md), amber $1 and cyan $2. A config without "modules"
// prints the logo and nothing else, so the list is fastfetch's default.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/kubaos.txt",
    "color": { "1": "38;2;253;184;130", "2": "38;2;141;209;226" },
    "padding": { "right": 2 }
  },
  "display": {
    "color": { "keys": "38;2;253;184;130" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
