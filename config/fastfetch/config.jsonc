// fastfetch on KubaOS: the クバ mark from branding/fastfetch.txt
// (branding/README.md). A config without "modules" prints the logo and
// nothing else, so the list is fastfetch's default. Its colours are the
// wallpaper theme's (config/matugen/templates/fastfetch.jsonc): dot-config
// merges them over this file, and your settings over both.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/kubaos.txt",
    "padding": { "right": 2 }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
