# Identity (user.name, user.email) isn't in the repo. The installer's Git
# screen or first-boot setup's Git card writes it, outside
# ~/.config/git (read-only defaults). Git skips a missing include.
[include]
	path = ~/.config/git-identity/identity.gitconfig
# Commit signing with an SSH key from Bitwarden, through its SSH agent:
# user.signingKey, gpg.format = ssh, gpg.ssh.allowedSignersFile and
# commit.gpgSign, generated by dot-bw-setup (docs/SECRETS.md). Git skips a
# missing include, so commits are unsigned until dot-bw-setup has run.
[include]
	path = ~/.config/git-bitwarden/signing.gitconfig
[pull]
	rebase = true
[init]
	defaultBranch = main
[merge]
	conflictStyle = zdiff3
	tool = diffview
[rebase]
	updateRefs = true
	autoStash = true
[push]
	useForceIfIncludes = true
	autoSetupRemote = true
[rerere]
	autoUpdate = true
	enabled = true
[fetch]
	prune = true
[diff]
	algorithm = histogram
[mergetool]
	prompt = false
	keepBackup = false
[mergetool "vimdiff"]
	layout = LOCAL,BASE,REMOTE / MERGED
[mergetool "diffview"]
	cmd = nvim -n -c \"DiffviewOpen\" \"$MERGED\"
	trustExitCode = true

# HTTPS auth for GitHub goes through gh (installed by Nix, `gh auth login`).
# SSH remotes need nothing here.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# delta pager settings, generated by home-manager (home/cli.nix).
[include]
	path = ~/.config/git-nix/delta.gitconfig

# delta colors from the wallpaper theme (dot-theme, matugen). Git skips a
# missing include, so this is safe before the first run.
[include]
	path = ~/.local/state/theme/delta.gitconfig

# Your settings, last so they win (~/.config/kubaos, docs/CONTRACTS.md).
[include]
	path = ~/.config/kubaos/git/config
