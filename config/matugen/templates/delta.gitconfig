# Generated by matugen (dot-theme). Do not edit.
# Included by config/git/config after home-manager's delta settings
# (~/.config/git-nix/delta.gitconfig). Syntax colors follow the terminal
# palette (bat's "base16" theme, as in config/bat/config); added/removed
# lines get dim tints of the
# harmonized green/red, the changed words a stronger one.
[delta]
	syntax-theme = base16
	plus-style = syntax "{{colors.green.default.hex | set_lightness: 13.0 | set_saturation: 35.0}}"
	plus-emph-style = syntax "{{colors.green.default.hex | set_lightness: 22.0 | set_saturation: 45.0}}"
	minus-style = syntax "{{colors.red.default.hex | set_lightness: 13.0 | set_saturation: 35.0}}"
	minus-emph-style = syntax "{{colors.red.default.hex | set_lightness: 22.0 | set_saturation: 45.0}}"
	line-numbers-zero-style = "{{colors.outline_variant.default.hex}}"
	line-numbers-minus-style = "{{colors.red.default.hex}}"
	line-numbers-plus-style = "{{colors.green.default.hex}}"
	line-numbers-left-style = "{{colors.outline_variant.default.hex}}"
	line-numbers-right-style = "{{colors.outline_variant.default.hex}}"
	file-style = "{{colors.primary.default.hex}}" bold
	file-decoration-style = "{{colors.outline_variant.default.hex}}" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "{{colors.outline_variant.default.hex}}" box
	hunk-header-file-style = "{{colors.primary.default.hex}}"
	hunk-header-line-number-style = "{{colors.tertiary.default.hex}}"
	commit-decoration-style = "{{colors.outline_variant.default.hex}}" box
	blame-palette = "{{colors.surface.default.hex}} {{colors.surface_container_low.default.hex}}"
