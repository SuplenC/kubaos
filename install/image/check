#!/usr/bin/env bash
# install/image/check: unpack a payload in a privileged Linux container and
# check it from the inside (chroot). Prints ok/FAIL lines, exits 1 on any FAIL.
#
#   install/image/check [--arch x86_64|aarch64] [--payload DIR] [--keep]
#
#   --arch     default this machine's
#   --payload  payload dir (default install/out/payload-<arch>)
#   --keep     leave the unpacked tree in volume kubaos-image-check-<arch>
#
# Writes <payload>/packages.txt (dpkg -l of the payload) and
# <payload>/check.txt (this output). A pass also writes <payload>/check.ok,
# the sha256 of the manifest it passed; install/iso/build refuses a payload
# without a matching one.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
ARCH="$(uname -m)" PAYLOAD="" KEEP=0
die() { printf 'check: %s\n' "$*" >&2; exit 2; }
usage() { sed -n '2,/^set -euo/{/^set -euo/d; s/^# \{0,1\}//p}' "${BASH_SOURCE[0]}"; }

while (($#)); do
  case "$1" in
    --arch) ARCH="${2:?}"; shift ;;
    --payload) PAYLOAD="${2:?}"; shift ;;
    --keep) KEEP=1 ;;
    -h | --help) usage; exit 0 ;;
    *) die "unknown argument $1" ;;
  esac
  shift
done
case "$ARCH" in
  aarch64) DARCH=arm64 ;;
  x86_64) DARCH=amd64 ;;
  *) die "--arch must be aarch64 or x86_64" ;;
esac
PAYLOAD="${PAYLOAD:-$ROOT/install/out/payload-$ARCH}"
[[ -f "$PAYLOAD/manifest.json" ]] || die "no manifest.json in $PAYLOAD"
PAYLOAD="$(cd "$PAYLOAD" && pwd)"
TOOLS="kubaos-image-tools:$DARCH"
VOLUME="kubaos-image-check-$ARCH"

docker buildx build -q --platform "linux/$DARCH" -f "$HERE/Dockerfile" --target tools -t "$TOOLS" --load "$ROOT" >/dev/null
docker rm -f "kubaos-image-check-$ARCH" >/dev/null 2>&1 || true
rm -f "$PAYLOAD/check.ok"
rc=0
docker run --rm --name "kubaos-image-check-$ARCH" --platform "linux/$DARCH" --privileged \
  --cpus 6 --memory 8g \
  -v "$VOLUME:/check" -v "$PAYLOAD:/payload" -v "$HERE/lib:/lib-image:ro" \
  -e KEEP="$KEEP" "$TOOLS" /lib-image/check-inside.sh 2>&1 | tee "$PAYLOAD/check.txt" || rc=$?
((KEEP)) || docker volume rm "$VOLUME" >/dev/null 2>&1 || true
((rc)) || sha256sum "$PAYLOAD/manifest.json" | cut -d' ' -f1 >"$PAYLOAD/check.ok"
exit "$rc"
