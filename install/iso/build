#!/usr/bin/env bash
# install/iso/build: build the KubaOS live ISO in Docker (install/iso/README.md).
#
#   install/iso/build [--arch aarch64|x86_64] [--profile hw|vm] [--release]
#                       [--payload DIR] [--bin DIR] [--branding DIR] [--name NAME] [--zstd N]
#                       [--rebuild-base]
#                                 build iso/NAME.iso (default kubaos-CODENAME-VERSION-ARCH,
#                                 from the repo's CODENAME and VERSION, with -vm
#                                 appended for --profile vm)
#   install/iso/build bins [--arch A]
#                                 only build kubaos + kobo into iso/bin/ARCH
#   install/iso/build clean     remove this builder's containers, images and volumes
#
# --profile hw (default): linux-image-generic + linux-firmware, for real machines.
# --profile vm: linux-image-virtual, no firmware: smaller and faster for the bench.
# --release: no openssh-server and no bench SSH hook.
# --bin DIR: use prebuilt Linux binaries (kubaos, optional kobo) instead
#            of building the Cargo workspace in Docker.
# --branding DIR: optional rootfs/ and iso/ overlays plus hook.sh ROOTFS ISO_TREE
#            (default: branding/iso in the repo, when it exists).
# --payload DIR: copied to the ISO as /kubaos/payload, mounted in the live
#            system at /run/kubaos/payload. Default: stub-payload/ (manifest only).
#
# Docker objects are all called kubaos-iso-*. Limits: KUBAOS_ISO_CPUS (6),
# KUBAOS_ISO_MEM (8g).
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
OUT="$ROOT/iso"
CPUS="${KUBAOS_ISO_CPUS:-6}"
MEM="${KUBAOS_ISO_MEM:-8g}"
VOLUMES=(kubaos-iso-cargo kubaos-iso-target kubaos-iso-work-aarch64 kubaos-iso-work-x86_64)

die() { printf 'install/iso/build: %s\n' "$*" >&2; exit 1; }
say() { printf '==> %s\n' "$*" >&2; }
usage() { sed -n '2,/^set -euo/{/^set -euo/d; s/^# \{0,1\}//p}' "${BASH_SOURCE[0]}"; }
elapsed() { printf '%dm%02ds' $((SECONDS / 60)) $((SECONDS % 60)); }

platform() { case "$1" in aarch64) echo linux/arm64 ;; x86_64) echo linux/amd64 ;; *) die "bad arch $1" ;; esac; }

build_image() { # build_image TARGET PLATFORM
  docker buildx build -q --platform "$2" --target "$1" -t "kubaos-iso-$1:${2#linux/}" -f "$HERE/Dockerfile" "$HERE" >/dev/null
}

cmd_bins() {
  local arch=aarch64
  while (($#)); do
    case "$1" in
      --arch) arch="${2:?}"; shift ;;
      *) die "bins: unknown flag $1" ;;
    esac
    shift
  done
  local triple="$arch-unknown-linux-gnu" dest="$OUT/bin/$arch"
  say "building kubaos and kobo for $triple"
  build_image rust linux/arm64
  mkdir -p "$dest"
  # The target volume is shared by every checkout (worktree) of the repo, and
  # cargo decides freshness by mtime: in one target dir, a checkout whose files
  # are older than another checkout's last build gets that build's binaries.
  # So each checkout builds in its own subdirectory.
  local tdir
  tdir="/target/$(printf '%s' "$ROOT" | shasum | cut -c1-12)"
  docker run --rm --name "kubaos-iso-cargo-$arch" --cpus "$CPUS" --memory "$MEM" \
    -v kubaos-iso-cargo:/usr/local/cargo/registry \
    -v kubaos-iso-target:/target \
    -v "$ROOT:/src:ro" \
    -v "$dest:/dest" \
    -e CARGO_TARGET_DIR="$tdir" -e CARGO_PROFILE_RELEASE_STRIP=true -w /src \
    kubaos-iso-rust:arm64 \
    sh -c "cargo build --release --locked --target $triple -p kubaos-cli -p kubaos-kobo &&
           install -m 755 $tdir/$triple/release/kubaos $tdir/$triple/release/kobo /dest/"
  ls -la "$dest" >&2
}

cmd_build() {
  local arch=aarch64 profile=hw release=0 payload="$HERE/stub-payload" bins="" name="" zstd=19 rebuild=0
  local branding="$ROOT/branding/iso"
  while (($#)); do
    case "$1" in
      --arch) arch="${2:?}"; shift ;;
      --profile) profile="${2:?}"; shift ;;
      --release) release=1 ;;
      --payload) payload="${2:?}"; shift ;;
      --bin) bins="${2:?}"; shift ;;
      --branding) branding="${2:?}"; shift ;;
      --name) name="${2:?}"; shift ;;
      --zstd) zstd="${2:?}"; shift ;;
      --rebuild-base) rebuild=1 ;;
      *) die "unknown flag $1 (install/iso/build --help)" ;;
    esac
    shift
  done
  [[ $profile == hw || $profile == vm ]] || die "--profile hw|vm"
  platform "$arch" >/dev/null
  unset KUBAOS_VERSION KUBAOS_RELEASE_ID   # VERSION and CODENAME win over the environment
  # shellcheck disable=SC1091
  . "$HERE/lib/brand.env"
  local suffix=""
  [[ $profile == vm ]] && suffix=-vm
  [[ -n $name ]] || name="kubaos-$KUBAOS_RELEASE_ID-$KUBAOS_VERSION-$arch$suffix"
  if [[ -d $branding ]]; then branding="$(cd "$branding" && pwd)"; else branding="$OUT/.no-branding"; mkdir -p "$branding"; fi
  [[ -d $payload ]] || die "no payload dir $payload"
  payload="$(cd "$payload" && pwd)"
  # The payload is built from git HEAD, the ISO from the working tree: a
  # VERSION bump the payload hasn't seen would name the ISO after the wrong
  # release. The stub payload (0.0.0-stub) is exempt.
  local pv
  pv="$(sed -n 's/.*"version" *: *"\([^"]*\)".*/\1/p' "$payload/manifest.json" | head -1)"
  [[ $pv == *-stub || $pv == "$KUBAOS_VERSION" ]] ||
    die "payload $payload is release ${pv:-?}, VERSION says $KUBAOS_VERSION: rebuild it (just payload $arch)"
  if [[ -z $bins ]]; then
    cmd_bins --arch "$arch"
    bins="$OUT/bin/$arch"
  fi
  [[ -x $bins/kubaos ]] || die "no $bins/kubaos"
  bins="$(cd "$bins" && pwd)"
  mkdir -p "$OUT"

  say "building $name.iso ($arch, profile $profile, release $release)"
  # The builder always runs natively (arm64); mmdebstrap --arch builds a foreign
  # rootfs through binfmt. Running the whole build in an emulated amd64
  # container breaks apt's `cat >&13` hook ("Bad fd number").
  build_image iso linux/arm64
  docker run --rm --name "kubaos-iso-build-$arch-$profile" --privileged \
    --cpus "$CPUS" --memory "$MEM" \
    -v "kubaos-iso-work-$arch:/work" \
    -v "$HERE:/src:ro" -v "$bins:/bins:ro" -v "$payload:/payload:ro" -v "$OUT:/out" \
    -v "$branding:/branding:ro" \
    -e ARCH="$arch" -e PROFILE="$profile" -e RELEASE="$release" -e NAME="$name" \
    -e ZSTD_LEVEL="$zstd" -e REBUILD_BASE="$rebuild" \
    -e KUBAOS_VERSION="$KUBAOS_VERSION" -e KUBAOS_RELEASE_ID="$KUBAOS_RELEASE_ID" \
    kubaos-iso-iso:arm64 bash /src/lib/build-iso.sh
  say "built $OUT/$name.iso in $(elapsed)"
}

cmd_clean() {
  local c
  for c in $(docker ps -aq --filter name='^kubaos-iso-'); do docker rm -f "$c" >/dev/null; done
  docker image rm kubaos-iso-rust:arm64 kubaos-iso-iso:arm64 kubaos-iso-iso:amd64 >/dev/null 2>&1 || true
  docker volume rm "${VOLUMES[@]}" >/dev/null 2>&1 || true
  echo "removed kubaos-iso-* containers, images and volumes (iso/ kept)"
}

case "${1:-}" in
  bins) shift; cmd_bins "$@" ;;
  clean) cmd_clean ;;
  -h | --help | help) usage ;;
  *) cmd_build "$@" ;;
esac
