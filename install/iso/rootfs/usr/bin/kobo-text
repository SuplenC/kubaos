#!/bin/bash
# kobo-text: Kōbō's text mode, the fallback when the graphical one can't run.
# Strings follow docs/BRAND.md.
# Asks the same questions as Kōbō, writes /run/kubaos/install.toml and a
# 0600 secrets file, then runs `kubaos run --events human`.
set -u

PAYLOAD=/run/kubaos/payload
CONF=/run/kubaos/install.toml
SECRETS=/run/kubaos/secrets.toml

ask() { # ask VAR "Prompt" [default]
  local __v __d="${3:-}"
  read -r -p "$2${__d:+ [$__d]}: " __v
  printf -v "$1" '%s' "${__v:-$__d}"
}

ask_secret() { # ask_secret VAR "Prompt": twice, must match, non-empty
  local a b
  while :; do
    read -r -s -p "$2: " a; echo
    read -r -s -p "Again: " b; echo
    [ -n "$a" ] && [ "$a" = "$b" ] && break
    echo "Empty, or the two didn't match. Again."
  done
  printf -v "$1" '%s' "$a"
}

toml_str() { # a TOML basic string
  local s="${1//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '"%s"' "$s"
}

# done_line SECONDS: the Done line, its quip picked by the time the install took. The
# same buckets as `done_line` in crates/kubaos-kobo/src/view.rs.
done_line() {
  local s=$1 quip
  if ((s < 120)); then
    quip="Damn, that was quick."
  elif ((s < 300)); then
    quip='Not bad. Windows would still be on “Getting ready”.'
  elif ((s < 900)); then
    quip="Took its sweet time, but it's on there."
  else
    quip="Slow as hell. Blame the USB stick, I do."
  fi
  if ((s < 60)); then
    printf 'Done in %ds. %s Pull the stick and reboot.\n' "$s" "$quip"
  else
    printf 'Done in %dm %02ds. %s Pull the stick and reboot.\n' $((s / 60)) $((s % 60)) "$quip"
  fi
}

manifest_field() {
  sed -n "s/.*\"$1\" *: *\"\\([^\"]*\\)\".*/\\1/p" "$PAYLOAD/manifest.json" 2>/dev/null | head -1
}

codename="$(manifest_field codename)"
name="KubaOS${codename:+ $codename}"
if [ "${1:-}" = --fallback ]; then
  echo "$name. Text mode, because the pretty one didn't start."
else
  echo "$name, text mode. The graphical one is on tty1 (Ctrl+Alt+F1)."
fi
echo "Whatever's on here, it's had its chance. Let's fix this shit."
echo
if [ ! -f "$PAYLOAD/manifest.json" ]; then
  echo "Fuck. This stick has no system image on it ($PAYLOAD/manifest.json is missing)."
  echo "I've got nothing to install. Rebuild the ISO with --payload. Here's a shell meanwhile."
  exec bash -l
fi

default_user="$(manifest_field username)"
default_host="$(manifest_field hostname)"

echo "Disks:"
lsblk -dpno NAME,SIZE,MODEL,TRAN -e 7,11 | grep -v '/dev/zram' | sed 's/^/  /'
echo
first_disk="$(lsblk -dpno NAME,RM,TYPE -e 7,11 | awk '$2==0 && $3=="disk"{print $1; exit}')"
while :; do
  ask disk "Install to which disk" "$first_disk"
  [ -b "$disk" ] && break
  echo "$disk isn't a disk. Pick one from the list."
done
ask user "Your username" "$default_user"
# The same rule as `valid_hostname` in crates/kubaos-core/src/engine/validate.rs.
while :; do
  ask host "This machine's name (hostname)" "${default_host:-kubaos}"
  [[ $host =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] && break
  echo "Lowercase a-z, 0-9 and -, up to 63, with no - at either end. Again."
done
ask full "Your full name" "Kuba Example"
ask lang "Locale" "en_US.UTF-8"
# Comma-separated, the default first; a variant goes in brackets, us(intl). The
# engine checks the names against xkb when it validates.
while :; do
  ask kb "Keyboard layouts your fingers actually know, the default first (us,it)" "us"
  kb="${kb// /}"
  IFS=, read -r -a kbs <<<"$kb"
  ok=true
  for k in "${kbs[@]}"; do
    [[ $k =~ ^[a-z0-9_-]+(\([A-Za-z0-9_-]+\))?$ ]] || ok=false
  done
  ((${#kbs[@]} >= 1 && ${#kbs[@]} <= 4)) && $ok && break
  echo "One to four layouts, comma-separated, like us,it or us(intl). Again."
done
kb_layouts=""
kb_variants=""
for k in "${kbs[@]}"; do
  variant=""
  [[ $k == *\(* ]] && { variant="${k#*(}"; variant="${variant%)}"; }
  kb_layouts+="${kb_layouts:+, }$(toml_str "${k%%(*}")"
  kb_variants+="${kb_variants:+, }$(toml_str "$variant")"
done
ask tz "Timezone" "Europe/Rome"
ask gitname "Git name" "$full"
ask gitemail "Git email" ""
ask enc "Encrypt the disk? (y/n)" "y"
encrypt=true; [[ $enc == [nN]* ]] && encrypt=false
luks=""
$encrypt && ask_secret luks "Disk encryption passphrase (asked at every boot)"
ask_secret pw "Login password for $user"

umask 077
{
  echo "[locale]"
  echo "lang = $(toml_str "$lang")"
  echo "keyboard_layout = [$kb_layouts]"
  echo "keyboard_variant = [$kb_variants]"
  echo "timezone = $(toml_str "$tz")"
  echo
  echo "[host]"
  echo "hostname = $(toml_str "$host")"
  echo
  echo "[user]"
  echo "username = $(toml_str "$user")"
  echo "full_name = $(toml_str "$full")"
  echo
  echo "[disk]"
  echo "device = $(toml_str "$disk")"
  echo "encrypt = $encrypt"
  echo "target = { mode = \"whole\" }"
  if [ -n "$gitemail" ]; then
    echo
    echo "[git]"
    echo "name = $(toml_str "$gitname")"
    echo "email = $(toml_str "$gitemail")"
  fi
  echo
  echo "[payload]"
  echo "dir = \"$PAYLOAD\""
} >"$CONF"
{
  $encrypt && echo "luks_passphrase = $(toml_str "$luks")"
  echo "user_password = $(toml_str "$pw")"
} >"$SECRETS"

desc="$(lsblk -dno MODEL,SIZE "$disk" 2>/dev/null | sed 's/  */ /g; s/^ //')"
echo
cat "$CONF"
echo
echo "Last chance to not fuck this up."
echo "Everything on ${desc:+$desc, }$disk gets erased. Every partition, every OS on it. There's no undo."
ask go "Type yes to erase $disk and install" ""
[ "$go" = yes ] || { echo "Nothing touched. Your answers are in $CONF."; rm -f "$SECRETS"; exec bash -l; }
echo
echo "Installing. Go stare at a wall, it'll be done before you get bored."

started=$SECONDS
kubaos run --config "$CONF" --secrets "$SECRETS" --events human
rc=$?
rm -f "$SECRETS"
if [ $rc -eq 0 ]; then
  done_line $((SECONDS - started))
  ask r "Reboot now? (y/n)" "y"
  [[ $r == [yY]* ]] && systemctl reboot
else
  echo "Fuck. The install failed (exit $rc); the reason is above."
  echo "Full log: /var/log/kubaos-install.log. Fix it and run kobo-text again."
fi
exec bash -l
