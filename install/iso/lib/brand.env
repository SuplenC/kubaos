# KubaOS release identity (docs/BRAND.md), from the repo's VERSION and
# CODENAME. Sourced by install/image/build, build and lib/build-iso.sh.
# The ISO container has no repo root, so build passes KUBAOS_VERSION and
# KUBAOS_RELEASE_ID in and this file only derives the rest.
# lib/base-customize.sh hardcodes the live hostname.
if [[ -z ${KUBAOS_VERSION:-} || -z ${KUBAOS_RELEASE_ID:-} ]]; then
  _brand_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
  KUBAOS_VERSION="$(<"$_brand_root/VERSION")"
  KUBAOS_RELEASE_ID="$(<"$_brand_root/CODENAME")"
  unset _brand_root
fi
[[ $KUBAOS_VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "brand.env: VERSION '$KUBAOS_VERSION' isn't X.Y.Z" >&2; return 1; }
[[ $KUBAOS_RELEASE_ID =~ ^[a-z]+$ ]] || { echo "brand.env: CODENAME '$KUBAOS_RELEASE_ID' isn't a lowercase id" >&2; return 1; }
KUBAOS_VERSION_SHORT="${KUBAOS_VERSION%.*}"
# shinjuku -> Shinjuku.
KUBAOS_RELEASE="$(printf '%s' "${KUBAOS_RELEASE_ID:0:1}" | tr '[:lower:]' '[:upper:]')${KUBAOS_RELEASE_ID:1}"
KUBAOS_VOLID="KUBAOS_${KUBAOS_VERSION_SHORT//./_}"
KUBAOS_HOSTNAME=kubaos-live
