# Plain CLI tools. zsh/fzf/zoxide/atuin/direnv/oh-my-posh live in shell.nix,
# tmux/tms/ghostty in terminal.nix. lazygit, btop, nvim and git configs come
# from config/ (links.nix), so they are installed as packages only (no
# programs.<x>.settings).
{
  config,
  lib,
  pkgs,
  ...
}:
let
  # Generated by dot-theme (config/matugen); see docs/CONTRACTS.md.
  theme =
    name: config.lib.file.mkOutOfStoreSymlink "${config.home.homeDirectory}/.local/state/theme/${name}";
in
{
  home.packages = with pkgs; [
    neovim
    tree-sitter # nvim-treesitter (main) builds parsers with the tree-sitter CLI
    lazygit
    yazi
    eza
    bat
    fd
    ripgrep
    delta
    dust
    dysk
    btop
    jq
    yq-go
    xh
    tealdeer
    just
    glow
    gh
    fastfetch
    lazydocker
    # YubiKey C Bio: FIDO2 PIN, fingerprints, `ykman info` (docs/SECRETS.md).
    # From Nix, not apt: apt's yubikey-manager depends on pcscd, which the
    # FIDO Edition never needs (FIDO2 goes over /dev/hidraw). fido2-tools and
    # pamu2fcfg stay apt, next to the libfido2 that Ubuntu's pam_u2f uses.
    yubikey-manager
  ];

  # ~/.config/git holds config/git's files, so delta's git settings live next to it.
  # config/git/config pulls them in with:
  #   [include]
  #     path = ~/.config/git-nix/delta.gitconfig
  xdg.configFile."git-nix/delta.gitconfig".text = lib.generators.toGitINI {
    core.pager = lib.getExe pkgs.delta;
    interactive.diffFilter = "${lib.getExe pkgs.delta} --color-only";
    # Colors (syntax theme, plus/minus tints, decorations) come from
    # ~/.local/state/theme/delta.gitconfig, included after this file.
    delta = {
      navigate = true;
      line-numbers = true;
    };
  };

  # Wallpaper colors for eza and lazydocker (neither has a dir in config/).
  # Until dot-theme has run the links dangle and both use their defaults.
  xdg.configFile."eza/theme.yml".source = theme "eza.yml";
  xdg.configFile."lazydocker/config.yml".source = theme "lazydocker.yml";
}
