# Terminal stack: Ghostty (plain terminal), tmux, tms.
#
# The configs themselves are live-linked from config/{ghostty,tmux,tms} by
# links.nix. This module only installs packages and generates the tmux plugin
# loader, so nothing here writes under ~/.config/{tmux,ghostty,tms}.
{ pkgs, lib, ... }:
let
  # Replaces TPM. Same plugins as before, minus the ones that only fed the
  # status bar (tmux-cpu, tmux-battery) and the monokai-pro theme (colors now
  # come from ~/.local/state/theme/tmux.conf).
  tmuxPlugins = with pkgs.tmuxPlugins; [
    sensible
    vim-tmux-navigator
    better-mouse-mode
  ];
in
{
  home.packages = [
    pkgs.tmux
    pkgs.tmux-sessionizer # `tms`
    # GPU access on Ubuntu is wired in desktop.nix (generic-Linux GPU support).
    pkgs.ghostty
    # Font used by config/ghostty/config.
    pkgs.nerd-fonts.meslo-lg
  ];

  # Sourced at the bottom of config/tmux/tmux.conf (`source-file -q`).
  xdg.configFile."tmux-nix/plugins.conf".text = ''
    # Generated by home-manager (home/terminal.nix). Do not edit.
    ${lib.concatMapStringsSep "\n" (p: "run-shell ${p.rtp}") tmuxPlugins}
  '';
}
