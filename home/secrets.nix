# Secrets from one Bitwarden vault (docs/SECRETS.md):
#   - SSH: Bitwarden desktop's SSH agent serves the vault's keys; this module
#     points the whole session at it (zsh, Hyprland and everything it starts,
#     systemd --user and D-Bus activated services) and writes ~/.ssh/config.
#   - project env: `use bwenv <project>` in .envrc reads the GNOME keyring
#     cache that dot-bwenv fills.
# The desktop app, bw and pam_u2f come from system/70-bitwarden.sh, not Nix.
# dot-bw-setup writes the per-vault parts (~/.ssh/config.d/bitwarden, git
# signing, gh token, keyring entries).
{ config, lib, ... }:
let
  home = config.home.homeDirectory;
  # Where the .deb build of Bitwarden desktop listens (Snap and Flatpak use
  # other paths). Off until you enable it in the app: Settings -> SSH agent.
  agentSock = "${home}/.bitwarden-ssh-agent.sock";
  # User units linked to /dev/null: what `systemctl --user mask` does.
  masked =
    lib.genAttrs
      [
        "systemd/user/ssh-agent.socket"
        "systemd/user/ssh-agent.service"
        "systemd/user/gcr-ssh-agent.socket"
        "systemd/user/gcr-ssh-agent.service"
      ]
      (_: {
        source = config.lib.file.mkOutOfStoreSymlink "/dev/null";
      });
in
{
  # Login shell (hm-session-vars.sh). Hyprland is exec'd from that shell, so
  # it and every app it starts inherit it; autostart.lua's
  # `dbus-update-activation-environment --systemd --all` then hands it to
  # systemd --user and D-Bus activation too.
  home.sessionVariables.SSH_AUTH_SOCK = agentSock;
  # systemd --user from its start (environment.d), before Hyprland runs.
  systemd.user.sessionVariables.SSH_AUTH_SOCK = agentSock;

  # Ubuntu enables two more agents for every user: openssh's ssh-agent.socket
  # and gcr's gcr-ssh-agent.socket. Each runs `systemctl --user set-environment
  # SSH_AUTH_SOCK=<its socket>` when the user manager starts, which overrides
  # environment.d. Masked here, so nothing competes for SSH_AUTH_SOCK.
  # gnome-keyring itself runs without its ssh component (autostart.lua).
  xdg.configFile = masked // {

    # `use bwenv <project>...` in an .envrc: exports the project's variables
    # from the keyring (one secret-tool call, about 10 ms). Nothing there yet:
    # it says to run `dot-bwenv pull <project>` and exports nothing.
    "direnv/lib/bwenv.sh".text = ''
      # Generated by home-manager (home/secrets.nix). See docs/SECRETS.md.
      use_bwenv() {
        local project record
        for project in "$@"; do
          while IFS= read -r -d "" record; do
            export "''${record%%=*}=''${record#*=}"
          done < <(${home}/.local/bin/dot-bwenv env "$project")
        done
      }
    '';
  };

  programs.ssh = {
    enable = true;
    # The client is apt's openssh-client (package = null, the default).
    enableDefaultConfig = false;
    # Host blocks from the vault (dot-bw-setup); hand-written ones can go in
    # ~/.ssh/config.d/ too. Included first, so their settings win.
    includes = [ "config.d/*" ];
    # Even when SSH_AUTH_SOCK is missing (cron, a stripped env), keys come
    # from Bitwarden. Hosts without a block get every key the agent has.
    # YubiKey (ed25519-sk) keys from dot-ssh-sk-new aren't in that agent
    # (it takes Ed25519 and RSA only): their Host blocks in
    # ~/.ssh/config.d/local set IdentityFile and IdentityAgent none.
    settings."*".IdentityAgent = agentSock;
  };
}
