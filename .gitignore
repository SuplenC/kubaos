# macOS / editors
.DS_Store
._*
*.swp
*.swo
*~

# Nix build outputs and direnv caches
result
result-*
.direnv/

# Pre-#9 machine-local Hyprland overrides; now ~/.config/kubaos/desktop/hypr/hyprland.lua
config/hypr/local.lua

# Neovim scratch and runtime files (see config/nvim/.gitignore)
config/nvim/scretch
config/nvim/.repro
config/nvim/lazyvim.json.bak

# ISOs (just iso)
/iso/

# /usr/share/kubaos/wallpapers on a machine: a link to the wallpaper sets in
# the store, inside the KubaOS clone (system/lib.sh, link_wallpapers)
/wallpapers

# Python bytecode, from running the test scripts
__pycache__/

# Cargo build output of the workspace in Cargo.toml
/target

# Agent worktrees (Claude Code), each a checkout of its own.
.claude/worktrees/

# The token outputs built where they are read: the Nix build writes them for
# the packages and the home, `just tokens` into a checkout (docs/DESIGN.md,
# "Where the outputs are generated"). kubaos-tokens' tests hold this list to
# its own.
/qml/KubaOS/Components/Tokens.qml
/qml/KubaOS/Components/Symbols.qml
/config/hypr/tokens.lua
/config/ghostty/tokens
/config/foot/tokens.ini
/config/tmux/colors.conf
/config/fuzzel/tokens.ini
/config/fastfetch/theme.jsonc
/config/ohmyposh/config.toml
/config/matugen/templates/ghostty
/config/matugen/templates/foot.ini
/config/matugen/templates/tmux.conf
/config/matugen/templates/nvim.lua
/config/matugen/templates/fuzzel.ini
/config/matugen/templates/fastfetch.jsonc

# The specimen's pictures: `just shots specimen` renders them for a PR, and CI
# publishes main's to the branch chore/shots-specimen (docs/DESIGN.md,
# "Screenshot diffs"). Kept out, so a render into the old place is never added.
/design/specimen/
